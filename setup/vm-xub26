#!/bin/bash

# Xubuntu 26.04 VM provisioning.
#
# Kept separate from vm-xub24 so package differences can diverge cleanly over
# time, while preserving the same VM deployment contract.

# Sanity check: verify running inside a VM
if ! systemd-detect-virt -q -v; then
    echo "ERROR: This script must run inside a virtual machine"
    exit 1
fi

# fail on any errors
set -Eeuo pipefail

error_trap() {
    local rc=$?
    echo >&2 "${BASH_SOURCE[1]}:${BASH_LINENO[0]}: Command \`$BASH_COMMAND\` failed with exit code $rc"
    exit "$rc"
}
trap error_trap ERR

SETUP_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
# shellcheck source=/dev/null
source "${SETUP_DIR}/common-cli-packages.sh"

guest_agent_owner_token=

cleanup_guest_agent_guard() {
    local rc=$?
    trap - EXIT
    if [[ -n "$guest_agent_owner_token" ]]; then
        if ! /usr/local/sbin/jan-qga-guard release "$guest_agent_owner_token"; then
            echo "WARNING: failed to release the QEMU guest-agent guard; watchdog will retry" >&2
        fi
    fi
    exit "$rc"
}
trap cleanup_guest_agent_guard EXIT

acquire_guest_agent_guard() {
    guest_agent_owner_token=$(/usr/local/sbin/jan-qga-guard acquire "$$")
    export JAN_QGA_GUARD_TOKEN=$guest_agent_owner_token
}

release_guest_agent_guard() {
    /usr/local/sbin/jan-qga-guard release "$guest_agent_owner_token"
    guest_agent_owner_token=
    unset JAN_QGA_GUARD_TOKEN
}

disable_automatic_apt() {
    local unit
    local -a units=(
        apt-daily.timer
        apt-daily-upgrade.timer
        apt-daily.service
        apt-daily-upgrade.service
        unattended-upgrades.service
    )

    echo "==> Disabling automatic APT updates"
    for unit in "${units[@]}"; do
        systemctl mask --now "$unit"
    done

    cat > /etc/apt/apt.conf.d/20auto-upgrades <<'EOF'
APT::Periodic::Enable "0";
APT::Periodic::Update-Package-Lists "0";
APT::Periodic::Unattended-Upgrade "0";
EOF

    # A timer may have launched apt immediately before it was masked. Never
    # race dpkg; wait for that final process to release all package locks.
    echo "==> Waiting for active APT/dpkg jobs to finish"
    for _ in $(seq 1 300); do
        if ! fuser \
            /var/lib/dpkg/lock \
            /var/lib/dpkg/lock-frontend \
            /var/lib/apt/lists/lock \
            /var/cache/apt/archives/lock \
            >/dev/null 2>&1; then
            return 0
        fi
        sleep 1
    done

    echo "ERROR: timed out waiting for APT/dpkg locks" >&2
    return 1
}


cp -f -s -r /opt/jan/usr/* /usr/local
# cursors do not work in /usr/local/share/icons
cp -f -s -r /usr/local/share/icons/DMZ* /usr/share/icons/
cp -f -s -r /usr/local/share/icons/Rare* /usr/share/icons/


# Set non-interactive mode for apt/dpkg
export DEBIAN_FRONTEND=noninteractive

# Prevent qemu-guest-agent from restarting during package operations.
# A restart kills the vm-exec connection we're running through.
# Clear a persistent mask left by an older interrupted setup, then use only a
# runtime mask. The EXIT trap removes it on ordinary failures, and reboot
# inherently removes it after power loss or a killed process.
if [[ -n "${JAN_QGA_GUARD_TOKEN:-}" ]]; then
    /usr/local/sbin/jan-qga-guard verify "$JAN_QGA_GUARD_TOKEN"
else
    acquire_guest_agent_guard
fi

disable_automatic_apt

apt-get update
apt-get install -y \
  terminator rofi mousepad arandr dconf-cli \
  xfce4-fsguard-plugin xfce4-systemload-plugin xfce4-taskmanager \
  links "${JAN_COMMON_CLI_PACKAGES[@]}" iftop sshpass starship \
  fonts-jetbrains-mono fonts-terminus console-setup \
  xdotool

# Seed future VM accounts. The XFCE files are ignored by Plasma, and VM-only
# display handling is a separate XFCE autostart entry.
/opt/jan/skel/install

# Guest agents — install but don't restart (masked above)
apt-get install -y spice-vdagent qemu-guest-agent


apt-get purge -y snapd \
  tumbler tumbler* \
  xfce4-terminal \
  libwebkit2gtk-* \
  cups* printer-driver* \
  xfce4-screensaver network-manager-gnome \
  *packagekit* apport* yelp* \
  xterm xfce4-screensaver xscreensaver \
  pulseaudio* gstreamer* bluez* pipewire* pavucontrol \
  network-manager-gnome \
  xserver-xorg-video-all memtest86+ mesa-vulkan-drivers \
  bind9* colord* \
  avahi-daemon apparmor *fwup* \
  poppler-* libavcodec* libcodec* \
  fonts-noto-cjk

block-pkg() {
   for PKG in "$@"; do
     FILE="/etc/apt/preferences.d/block-$PKG.pref"
     # Idempotent: rewrite the file (overwrite, not append) so re-runs don't
     # duplicate the Pin entry. apt is fine with multiple identical pins,
     # but the file grows unboundedly and is a confusing diff.
     printf 'Package: %s\nPin: release *\nPin-Priority: -1\n' "$PKG" > "$FILE"
     echo "== blocked $PKG"
   done
}

block-pkg snapd tumbler yelp cups-browsed cups xfce4-screensaver
apt-get autoremove -y
apt-get clean


jan-systemd-tty11-root
jan-systemd-vm-cleanup
jan-console-font || echo "WARNING: console font setup failed (non-fatal)"
# sysfb/simpledrm may take DRM card0 before virtio_gpu and later disappear,
# leaving virtio_gpu at card1. spice-vdagent expects card0 when mapping the
# SPICE display to XRandR, so this breaks resize and absolute pointer mapping.
jan-setup-kernel-tweaks \
    initcall_blacklist=sysfb_init,simpledrm_platform_driver_init \
    || echo "WARNING: kernel tweaks setup failed (non-fatal)"
jan-setup-pkg-safety || echo "WARNING: pkg safety setup failed (non-fatal)"



#
# lower case user folders
#
cat << EOF >  /etc/xdg/user-dirs.defaults
DESKTOP=desk
DOWNLOAD=down
DOCUMENTS=doc
TEMPLATES=doc/templates
PUBLICSHARE=media/share
MUSIC=media/music
PICTURES=media/pic
VIDEOS=media/video
EOF


# Preserve the original pre-provisioning home once. A fixed staging destination
# keeps repeated and interrupted runs bounded; an interrupted copy is rebuilt.
jan_home_backup=/var/backups/jan-home-before-vm-xub26
jan_home_backup_stage=${jan_home_backup}.partial
jan_home_backup_payload=$jan_home_backup/home/jan
jan_home_backup_marker=$jan_home_backup/.complete
if [[ ! -e "$jan_home_backup_marker" ]]; then
    rm -rf -- "$jan_home_backup_stage"
    install -d -o root -g root -m 0700 "$jan_home_backup_stage/home/jan"
    rsync -aHAXSx --numeric-ids --delete /home/jan/ "$jan_home_backup_stage/home/jan/"
    chown root:root "$jan_home_backup_stage" "$jan_home_backup_stage/home"
    chmod 0700 "$jan_home_backup_stage" "$jan_home_backup_stage/home"
    touch "$jan_home_backup_stage/.complete"
    rm -rf -- "$jan_home_backup"
    mv "$jan_home_backup_stage" "$jan_home_backup"
elif [[ ! -d "$jan_home_backup_payload" ]]; then
    echo "ERROR: home-backup marker exists but $jan_home_backup_payload is missing" >&2
    exit 1
fi

# Sync repo dotfiles into /home/jan and /root.
#
# Note: NO --delete. With --delete, rsync removes anything in the destination
# that's not in the source, which blasts user data dirs (~/down, ~/doc,
# ~/.cache, ~/.mozilla, etc.) on every re-run. Trade-off: stale dotfiles
# accumulate when removed from the repo. That's acceptable; user-data
# preservation is more important than dotfile cleanliness.

rsync -a /opt/jan/skel/home/ /home/jan
[[ -d /opt/jan/home-root ]] && rsync -r /opt/jan/home-root/ /root

chmod 0755 /home
chmod 0700 /root/
for home_dir in /home/*/; do
    [[ -d "$home_dir" ]] || continue
    chmod 0700 "$home_dir"
done
chown jan:users -R /home/jan
rm -rf /home/jan/.cache/sessions

configure-user-dirs() {
    local user=$1
    local group=$2
    local home_dir=$3

    su - "$user" -c 'mkdir -p ~/desk ~/down ~/doc ~/doc/templates ~/media/share ~/media/music ~/media/pic ~/media/video'
    install -d -o "$user" -g "$group" "$home_dir/.config"
    cat > "$home_dir/.config/user-dirs.dirs" <<'EOF'
XDG_DESKTOP_DIR="$HOME/desk"
XDG_DOWNLOAD_DIR="$HOME/down"
XDG_TEMPLATES_DIR="$HOME/doc/templates"
XDG_PUBLICSHARE_DIR="$HOME/media/share"
XDG_DOCUMENTS_DIR="$HOME/doc"
XDG_MUSIC_DIR="$HOME/media/music"
XDG_PICTURES_DIR="$HOME/media/pic"
XDG_VIDEOS_DIR="$HOME/media/video"
EOF
    chown "$user":"$group" "$home_dir/.config/user-dirs.dirs"
    su - "$user" -c 'rm -rf ~/Desktop ~/Documents ~/Downloads ~/Music ~/Pictures ~/Public ~/Templates ~/Videos'
}

configure-user-dirs jan users /home/jan

# Re-enable the guest agent when this standalone script owns the guard. When
# called by vm-ub26-xfce, the wrapper retains the lease and performs the final
# enable/start verification after releasing it.
if [[ -n "$guest_agent_owner_token" ]]; then
    release_guest_agent_guard
    systemctl enable qemu-guest-agent.service
    systemctl start qemu-guest-agent.service
    systemctl is-enabled --quiet qemu-guest-agent.service
    systemctl is-active --quiet qemu-guest-agent.service
fi

# Runtime masks and the EXIT cleanup supersede the older boot-time recovery
# helper. Remove copies created by previous versions; the helper also had a
# multi-user.target ordering cycle.
systemctl disable jan-unmask-guest-agents.service 2>/dev/null || true
rm -f /etc/systemd/system/jan-unmask-guest-agents.service
systemctl daemon-reload

echo =========== DONE ===========
