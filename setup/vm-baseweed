#!/bin/bash
# Tumbleweed graphical VM profile, layered over the shared text-only setup.
set -Eeuo pipefail
if (( EUID != 0 )); then
    echo "ERROR: vm-baseweed must run as root" >&2
    exit 1
fi
if ! systemd-detect-virt -q -v; then
    echo "ERROR: This script must run inside a virtual machine" >&2
    exit 1
fi
SETUP_DIR=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
cp -f -s -r /opt/jan/usr/* /usr/local
/opt/jan/setup/retire-path-util-names.sh
export PATH="/usr/local/sbin:/usr/local/bin:$PATH"
guest_agent_owner_token=
cleanup_guest_agent_guard() {
    local rc=$?
    trap - EXIT
    if [[ -n "$guest_agent_owner_token" ]]; then
        if ! /usr/local/sbin/qga-guard release "$guest_agent_owner_token"; then
            echo "WARNING: failed to release the QEMU guest-agent guard; watchdog will retry" >&2
        fi
    fi
    exit "$rc"
}
trap cleanup_guest_agent_guard EXIT
# Recover persistent state left by older versions before taking a runtime lease.
systemctl unmask spice-vdagentd.service
systemctl disable jan-unmask-guest-agents.service 2>/dev/null || true
rm -f /etc/systemd/system/jan-unmask-guest-agents.service
systemctl daemon-reload
guest_agent_owner_token=$(/usr/local/sbin/qga-guard acquire "$$")
export JAN_QGA_GUARD_TOKEN=$guest_agent_owner_token
default_target=$(systemctl get-default)
if ! command -v apt >/dev/null 2>&1; then
    zypper -n install --no-recommends zypper-aptitude
fi
"$SETUP_DIR/vm-cli"
systemctl set-default "$default_target"
# shellcheck source=/dev/null
source "$SETUP_DIR/common-cli-packages.sh"
apt "${JAN_APT_INSTALL_OPTIONS[@]}" install \
    terminator rofi mousepad arandr zim \
    xfce4-fsguard-plugin xfce4-systemload-plugin xfce4-taskmanager jetbrains-mono-fonts
/usr/local/sbin/install-chrome-vm
/usr/local/sbin/install-brave-vm
install-tty11-root
install-guest-cleanup
setup-kernel-tweaks initcall_blacklist=sysfb_init,simpledrm_platform_driver_init
/usr/local/sbin/qga-guard release "$guest_agent_owner_token"
guest_agent_owner_token=
unset JAN_QGA_GUARD_TOKEN
systemctl enable qemu-guest-agent.service
systemctl start qemu-guest-agent.service spice-vdagentd.service
systemctl is-enabled --quiet qemu-guest-agent.service
systemctl is-active --quiet qemu-guest-agent.service
systemctl is-active --quiet spice-vdagentd.service
