#!/bin/bash
#
# host-weed-kde — finish a fresh openSUSE Tumbleweed + KDE Plasma install.
#
# Counterpart to setup/vm-baseweed, but for a bare-metal / desktop HOST
# running Plasma 6 on Wayland (not a headless XFCE VM). It:
#
#   - symlinks /usr/local <- repo usr/
#   - installs KDE apps, virt stack, and CLI tools via zypper
#   - locks packages we never want pulled in (X server, vim, PackageKit, ...)
#   - masks services we replace or don't use (sddm, fwupd, ollama, ...)
#   - leaves tty1 stock; sets up agetty on tty2-10 and CLI-started Plasma
#   - runs the cross-distro jan-* helpers
#   - applies the curated skeleton WITHOUT --delete (user data survives re-runs)
#
# Idempotent: safe to re-run. Run as root from a checkout, e.g.
#   sudo /opt/jan/setup/host-weed-kde
#
# NOTE: unlike vm-baseweed this does NOT install jan-systemd-tty11-root —
# that grants unauthenticated root on a console TTY and is VM-only.

if [ "$EUID" -ne 0 ]; then
    echo "Please run as root" >&2
    exit 1
fi

set -euo pipefail
trap 'echo >&2 "${BASH_SOURCE[0]}:${BASH_LINENO[0]}: Command \`$BASH_COMMAND\` failed with exit code $?"; exit $?' ERR

# Sanity check: this is a Tumbleweed-specific script.
if ! grep -q '^ID="\?opensuse-tumbleweed' /etc/os-release 2>/dev/null; then
    echo "ERROR: this script targets openSUSE Tumbleweed" >&2
    exit 1
fi

# This is a host/desktop finisher; warn (don't fail) if run inside a VM —
# use setup/vm-baseweed for VMs.
if systemd-detect-virt -q -v; then
    echo "WARNING: running inside a VM — setup/vm-baseweed is the VM script" >&2
fi

REPO_DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
# shellcheck source=/dev/null
source "${REPO_DIR}/setup/common-cli-packages.sh"

# ---------- repo usr/ -> /usr/local symlinks ----------

echo "==> Symlinking ${REPO_DIR}/usr -> /usr/local"
cp -f -s -r "${REPO_DIR}/usr/"* /usr/local

# Keep the Sweet palette in one installed color-scheme file. KConfig needs the
# palette groups in its global cascade as well as the ColorScheme name in each
# user's kdeglobals, so expose the same file there rather than copying it into
# every home directory.
install -d -o root -g root -m 0755 /usr/local/etc /usr/local/etc/xdg
ln -sfn /usr/local/share/color-schemes/Sweet-dark.colors \
    /usr/local/etc/xdg/kdeglobals
ln -sfn /usr/local/share/jan-xdg-local-first.sh \
    /etc/profile.d/jan-xdg-local-first.sh
ln -sfn /usr/local/share/fontconfig/conf.avail/60-jan-jetbrains-mono.conf \
    /etc/fonts/conf.d/60-jan-jetbrains-mono.conf
fc-cache -f

# The jan-* helpers now live in /usr/local/{sbin,bin}. Make sure they're on
# PATH for the rest of this script regardless of how it was invoked (a
# locked-down sudo secure_path or a guest-agent exec may omit /usr/local).
export PATH="/usr/local/sbin:/usr/local/bin:$PATH"

# ---------- Package install ----------

echo "==> Refreshing repositories"
zypper -n refresh

# Core set: confirmed-valid package names, must succeed.
echo "==> Installing KDE apps, virt stack, and CLI tools"
zypper -n install --no-recommends \
    konsole dolphin kate kwrite ark gwenview okular spectacle \
    kdenlive kdiff3 kfind krename krita kstars ksystemlog ktorrent \
    filelight partitionmanager \
    virt-manager virt-install virt-viewer qemu podman lima \
    "${JAN_COMMON_CLI_PACKAGES[@]}" \
    sshpass jq yq fzf dconf \
    NetworkManager-tui jetbrains-mono-fonts \
    java-17-openjdk-devel maven

# Seed future accounts (including lab users) with the curated common,
# Plasma-safe, and XFCE-safe defaults. openSUSE continues to merge its vendor
# files from /usr/etc/skel; this installs only administrator overrides.
"${REPO_DIR}/skel/install"

# ---------- Package locks (the "masked" packages) ----------
# Remove if present, then lock so they can't be pulled back in. The X server
# is locked because this host runs pure Wayland; vim/emacs/PackageKit are
# deliberately unwanted.

LOCK_PKGS=(PackageKit emacs icewm vim vim-small xterm xorg-x11-server)
echo "==> Removing and locking unwanted packages"
for pkg in "${LOCK_PKGS[@]}"; do
    rpm -q "$pkg" &>/dev/null && zypper -n rm -u "$pkg" 2>/dev/null || true
    zypper -n addlock "$pkg" 2>/dev/null || true
done
# Block the kde_pim pattern (kmail/akonadi stack).
zypper -n addlock -t pattern kde_pim 2>/dev/null || true

# ---------- Mask unused / replaced services ----------
# Plasma is started from agetty logins (below). The rest are simply not used.
# Guard each: a fresh install may not have all of these units.
echo "==> Masking unused services"
for unit in sddm.service fwupd.service ollama.service forgejo-runner.service; do
    systemctl mask "$unit" 2>/dev/null || true
done

# ---------- Cross-distro jan-* helpers ----------
# tty11-root is intentionally omitted (see header).

echo "==> Running jan-* setup helpers"
jan-console-font            || echo "WARNING: console font setup failed (non-fatal)"
jan-console-framebuffer
jan-setup-pkg-safety        || echo "WARNING: pkg safety setup failed (non-fatal)"
jan-setup-kernel-tweaks     || echo "WARNING: kernel tweaks setup failed (non-fatal)"
jan-setup-agetty
jan-systemd-tty12-menu      || echo "WARNING: tty12 menu setup failed (non-fatal)"
# Patch virt-manager/remote-viewer to run under XWayland (fractional scaling fix).
jan-fix-virtman-scaling     || echo "WARNING: virt-manager scaling fix failed (non-fatal)"

# AMD Strix Halo unified-memory tuning — only on matching hardware.
if lspci -nn 2>/dev/null | grep -qi 'Strix Halo'; then
    echo "==> Strix Halo detected — applying GPU/memory tweaks"
    jan-setup-strix-halo    || echo "WARNING: strix-halo setup failed (non-fatal)"
fi

# ---------- Replace all wallpapers with a single image ----------
# Point every wallpaper/background image under /usr/share at the single
# wallpaper shipped in the repo (usr/share/jan-wallpaper.jpg, deployed to
# /usr/local/share/jan-wallpaper.jpg by the symlink step above), so KDE (and
# anything else) always shows it regardless of which theme / resolution
# variant it picks. Symlinks are idempotent, so re-runs are safe.

echo "==> Replacing /usr/share wallpapers with a single image"
WALLPAPER_FILE="/usr/local/share/jan-wallpaper.jpg"
if [[ -e "$WALLPAPER_FILE" ]]; then
    WALL_DIRS=()
    for d in /usr/share/wallpapers /usr/share/backgrounds; do
        [[ -d "$d" ]] && WALL_DIRS+=("$d")
    done
    if [[ ${#WALL_DIRS[@]} -gt 0 ]]; then
        find "${WALL_DIRS[@]}" \( -type f -o -type l \) \
            \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \
               -o -iname '*.webp' -o -iname '*.bmp' -o -iname '*.svg' \) \
            -print0 | while IFS= read -r -d '' img; do
            ln -sf "$WALLPAPER_FILE" "$img"
        done
    fi
else
    echo "WARNING: ${WALLPAPER_FILE} missing — keeping existing wallpapers" >&2
fi

# Boot straight to the graphical session.
systemctl set-default graphical.target

# ---------- xdg user-dirs (lowercase) ----------

echo "==> Configuring lowercase XDG user dirs"
cat << EOF > /etc/xdg/user-dirs.defaults
DESKTOP=desk
DOWNLOAD=down
DOCUMENTS=doc
TEMPLATES=doc/templates
PUBLICSHARE=media/share
MUSIC=media/music
PICTURES=media/pic
VIDEOS=media/video
EOF

# ---------- Apply curated user skeleton (NO --delete) ----------
# Detect the primary unprivileged user. openSUSE's installer-created account
# is commonly adam on these hosts, so prefer it before legacy repo defaults.

HOME_USER=""
for u in adam jan playai opensuse tumbleweed; do
    if id "$u" &>/dev/null; then
        HOME_USER="$u"
        break
    fi
done
if [[ -z "$HOME_USER" ]]; then
    echo "ERROR: no candidate user found (tried: adam jan playai opensuse tumbleweed)" >&2
    exit 1
fi
HOME_GROUP=$(id -gn "$HOME_USER")
HOME_DIR=$(getent passwd "$HOME_USER" | cut -d: -f6)
echo "==> Applying curated user defaults to ${HOME_DIR} (user=${HOME_USER})"

# Back up the complete existing home before replacing any managed template.
# Fail before deployment if the backup cannot be made.
HOME_BACKUP="${HOME_DIR}-backup-$(date +%Y-%m-%d-%H%M%S)-$$"
echo "==> Backing up ${HOME_DIR} to ${HOME_BACKUP}"
cp -a -- "$HOME_DIR" "$HOME_BACKUP"
chmod 0700 "$HOME_BACKUP"

# Apply the same curated payload installed into /etc/skel. It is a superset of
# the legacy home/ tree and adds the Plasma/Konsole defaults an account created
# by the OS installer could not have received. No --delete: personal files
# outside the managed paths survive.
rsync -a --chown="${HOME_USER}:${HOME_GROUP}" "${REPO_DIR}/skel/home/" "${HOME_DIR}/"
[[ -d "${REPO_DIR}/home-root" ]] && rsync -r "${REPO_DIR}/home-root/" /root/

# Fix ownership BEFORE the su below, otherwise the freshly-synced (root-owned)
# dotfiles aren't readable by the user and their login shell errors out
# sourcing ~/.profile.
chmod 0755 /home
chmod 0700 "$HOME_DIR" /root
chown "$HOME_USER":"$HOME_GROUP" -R "$HOME_DIR"

configure-user-dirs() {
    local user=$1
    local group=$2
    local home_dir=$3

    su - "$user" -c 'mkdir -p ~/desk ~/down ~/doc ~/doc/templates ~/media/share ~/media/music ~/media/pic ~/media/video'
    install -d -o "$user" -g "$group" "$home_dir/.config"
    cat > "$home_dir/.config/user-dirs.dirs" <<'EOF'
XDG_DESKTOP_DIR="$HOME/desk"
XDG_DOWNLOAD_DIR="$HOME/down"
XDG_TEMPLATES_DIR="$HOME/doc/templates"
XDG_PUBLICSHARE_DIR="$HOME/media/share"
XDG_DOCUMENTS_DIR="$HOME/doc"
XDG_MUSIC_DIR="$HOME/media/music"
XDG_PICTURES_DIR="$HOME/media/pic"
XDG_VIDEOS_DIR="$HOME/media/video"
EOF
    chown "$user":"$group" "$home_dir/.config/user-dirs.dirs"
    su - "$user" -c '
        migrate_dir() {
            src=$1
            dst=$2
            [ -d "$src" ] || return 0
            mkdir -p "$dst"
            find "$src" -mindepth 1 -maxdepth 1 -exec mv -n -t "$dst" {} +
            rmdir "$src" 2>/dev/null || true
        }
        migrate_dir ~/Desktop ~/desk
        migrate_dir ~/Documents ~/doc
        migrate_dir ~/Downloads ~/down
        migrate_dir ~/Music ~/media/music
        migrate_dir ~/Pictures ~/media/pic
        migrate_dir ~/Public ~/media/share
        migrate_dir ~/Templates ~/doc/templates
        migrate_dir ~/Videos ~/media/video
    '
}

configure-user-dirs "$HOME_USER" "$HOME_GROUP" "$HOME_DIR"

systemctl daemon-reload

echo "=========== DONE ==========="
echo "Reboot to activate stock tty1, managed agetty logins on tty2-10, and the Full HD console."
