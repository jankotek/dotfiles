#!/bin/bash
#
# host-weed-kde — install Plasma Wayland and tools on openSUSE Tumbleweed.
#
# Counterpart to setup/vm-baseweed, but for a bare-metal / desktop HOST
# running Plasma 6 on Wayland (not a headless XFCE VM). It:
#
#   - symlinks /usr/local <- repo usr/
#   - installs KDE apps, virt stack, and CLI tools via zypper
#   - locks packages we never want pulled in (X server, vim, PackageKit, ...)
#   - masks services we replace or don't use (sddm, fwupd, ...)
#   - leaves tty1 stock; sets up agetty on tty2-10 and CLI-started Plasma
#   - runs the cross-distro setup helpers
#   - installs curated defaults into /etc/skel without touching existing homes
#
# Idempotent: safe to re-run. Run as root from a checkout, e.g.
#   sudo /opt/jan/setup/host-weed-kde
#
# NOTE: unlike vm-baseweed this does NOT install install-tty11-root —
# that grants unauthenticated root on a console TTY and is VM-only.

if [ "$EUID" -ne 0 ]; then
    echo "Please run as root" >&2
    exit 1
fi

set -Eeuo pipefail
error_trap() {
    local rc=$?
    echo >&2 "${BASH_SOURCE[1]}:${BASH_LINENO[0]}: Command \`$BASH_COMMAND\` failed with exit code $rc"
    exit "$rc"
}
trap error_trap ERR

# Sanity check: this is a Tumbleweed-specific script.
if ! grep -q '^ID="\?opensuse-tumbleweed' /etc/os-release 2>/dev/null; then
    echo "ERROR: this script targets openSUSE Tumbleweed" >&2
    exit 1
fi

# This is a host/desktop finisher; warn (don't fail) if run inside a VM —
# use setup/vm-baseweed for VMs.
if systemd-detect-virt -q -v; then
    echo "WARNING: running inside a VM — setup/vm-baseweed is the VM script" >&2
fi

REPO_DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
# shellcheck source=/dev/null
source "${REPO_DIR}/setup/common-cli-packages.sh"

# ---------- repo usr/ -> /usr/local symlinks ----------

echo "==> Symlinking ${REPO_DIR}/usr -> /usr/local"
cp -f -s -r "${REPO_DIR}/usr/"* /usr/local
"${REPO_DIR}/setup/retire-path-util-names.sh"

# Keep the Sweet palette in one installed color-scheme file. KConfig needs the
# palette groups in its global cascade as well as the ColorScheme name in each
# user's kdeglobals, so expose the same file there rather than copying it into
# every home directory.
install -d -o root -g root -m 0755 /usr/local/etc /usr/local/etc/xdg
ln -sfn /usr/local/share/color-schemes/Sweet-dark.colors \
    /usr/local/etc/xdg/kdeglobals
ln -sfn /usr/local/share/jan-xdg-local-first.sh \
    /etc/profile.d/jan-xdg-local-first.sh

# Repo helpers now live in /usr/local/{sbin,bin}. Make sure they're on
# PATH for the rest of this script regardless of how it was invoked (a
# locked-down sudo secure_path or a guest-agent exec may omit /usr/local).
export PATH="/usr/local/sbin:/usr/local/bin:$PATH"

# ---------- Package install ----------

echo "==> Refreshing repositories"
zypper -n refresh

# Enforce host policy before resolving the desktop installation. XWayland
# (xorg-x11-server-wayland) stays available for X11 applications under Plasma.
# Locking the X server and its wrapper is what makes an X11 Plasma session
# unusable; Plasma 6.8 itself no longer ships a separate X11 session package.
LOCK_PKGS=(
    PackageKit emacs icewm vim vim-small xterm xterm-bin
    xorg-x11-server xorg-x11-server-wrapper
)
echo "==> Removing and locking unwanted packages"
for pkg in "${LOCK_PKGS[@]}"; do
    # A refused removal (reverse dependency we still need) must not abort the
    # run before anything is installed. The lock below still blocks reinstalls.
    if rpm -q "$pkg" &>/dev/null; then
        zypper -n remove "$pkg" || echo "WARNING: could not remove $pkg; lock still applies" >&2
    fi
    zypper -n addlock "$pkg"
done
zypper -n addlock -t pattern kde_pim

# Core set: confirmed-valid package names, must succeed.
echo "==> Installing KDE apps, virt stack, and CLI tools"
zypper -n install --no-recommends \
    plasma6-session plasma6-nm plasma6-pa xdg-desktop-portal-kde6 \
    plasma6-theme-openSUSE \
    pipewire-pulseaudio wireplumber power-profiles-daemon \
    konsole dolphin kate kwrite ark gwenview okular spectacle \
    kdenlive kdiff3 kfind krename krita kstars ksystemlog ktorrent \
    filelight partitionmanager \
    virt-manager virt-install virt-viewer qemu podman lima \
    libguestfs guestfs-tools libguestfs-appliance libguestfs-xfs virtiofsd passt \
    "${JAN_COMMON_CLI_PACKAGES[@]}" zim "${JAN_DISTRO_CLI_PACKAGES[@]}" zypper-aptitude \
    sshpass jq yq dconf \
    NetworkManager-tui jetbrains-mono-fonts \
    java-17-openjdk-devel maven

fc-cache -f
systemctl enable --now power-profiles-daemon.service

# Seed future accounts (including lab users) with the curated common,
# Plasma-safe, and XFCE-safe defaults. openSUSE continues to merge its vendor
# files from /usr/etc/skel; this installs only administrator overrides.
"${REPO_DIR}/skel/install"

# ---------- Mask unused / replaced services ----------
# Plasma is started from agetty logins (below). The rest are simply not used.
# Guard each: a fresh install may not have all of these units.
echo "==> Masking unused services"
for unit in sddm.service fwupd.service forgejo-runner.service; do
    systemctl mask "$unit" 2>/dev/null || true
done

# ---------- Cross-distro setup helpers ----------
# tty11-root is intentionally omitted (see header).

echo "==> Running setup helpers"
console-font            || echo "WARNING: console font setup failed (non-fatal)"
install-fontconfig      || echo "WARNING: fontconfig setup failed (non-fatal)"
install-cursor-theme    || echo "WARNING: cursor theme setup failed (non-fatal)"
setup-plasma-defaults   || echo "WARNING: Plasma defaults setup failed (non-fatal)"
console-framebuffer
setup-pkg-safety        || echo "WARNING: pkg safety setup failed (non-fatal)"
setup-kernel-tweaks     || echo "WARNING: kernel tweaks setup failed (non-fatal)"
setup-agetty
setup-ac-no-suspend
install-tty12-menu      || echo "WARNING: tty12 menu setup failed (non-fatal)"
# Patch virt-manager/remote-viewer to run under XWayland (fractional scaling fix).
fix-virtman-scaling     || echo "WARNING: virt-manager scaling fix failed (non-fatal)"

# AMD Strix Halo unified-memory tuning — only on matching hardware.
if lspci -nn 2>/dev/null | grep -qi 'Strix Halo'; then
    echo "==> Strix Halo detected — applying GPU/memory tweaks"
    setup-strix-halo    || echo "WARNING: strix-halo setup failed (non-fatal)"
fi

# ---------- Install the single wallpaper ----------
# Plasma names this path in the desktop and lock-screen defaults (see
# skel/.../layout-templates and usr/etc/xdg/kscreenlockerrc), so install a real
# copy rather than the /usr/local -> /opt/jan symlink the step above creates: a
# checkout that is absent, moved or unmounted must not blank the background.
#
# Deliberately does NOT rewrite the distribution's own images under
# /usr/share/wallpapers. Those files are rpm-owned, so a package update would
# restore them and silently revert the wallpaper.

echo "==> Installing the wallpaper"
WALLPAPER_SOURCE="${REPO_DIR}/usr/share/jan-wallpaper.jpg"
WALLPAPER_FILE="/usr/local/share/jan-wallpaper.jpg"
if [[ -f "$WALLPAPER_SOURCE" ]]; then
    rm -f "$WALLPAPER_FILE"
    install -D -m 0644 "$WALLPAPER_SOURCE" "$WALLPAPER_FILE"
else
    echo "WARNING: ${WALLPAPER_SOURCE} missing — no wallpaper installed" >&2
fi

# Boot straight to the graphical session.
systemctl set-default graphical.target

# ---------- xdg user-dirs (lowercase) ----------

echo "==> Configuring lowercase XDG user dirs"
cat << EOF > /etc/xdg/user-dirs.defaults
DESKTOP=desk
DOWNLOAD=down
DOCUMENTS=doc
TEMPLATES=doc/templates
PUBLICSHARE=media/share
MUSIC=media/music
PICTURES=media/pic
VIDEOS=media/video
EOF

# Existing host homes are intentionally unmanaged. The canonical skeleton was
# installed into /etc/skel above and is applied only when a user is created.
# Backups and changes to an existing user's dotfiles are separate manual tasks.

systemctl daemon-reload

echo "=========== DONE ==========="
echo "Reboot to activate stock tty1, managed agetty logins on tty2-10, and the Full HD console."
