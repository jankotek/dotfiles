#!/bin/bash
#
# Host setup — applies basic hardening to a fresh system.
#
# Installs no packages: CLI tools such as starship come from the distro
# (setup/host-weed-kde installs them on Tumbleweed).
#

if [ "$EUID" -ne 0 ]; then
    echo "Please run as root"
    exit 1
fi

set -euo pipefail

REPO_DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"

echo "=== Setting /home permissions ==="
chmod 0755 /home
for dir in /home/*/; do
    [ -d "$dir" ] || continue
    chmod 0700 "$dir"
    echo "  $dir -> 0700"
done
echo "  /home -> 0755"

echo "=== Installing repo tools into /usr/local ==="
cp -f -s -r "${REPO_DIR}/usr/"* /usr/local
"${REPO_DIR}/setup/retire-path-util-names.sh"

echo "=== Setting console font ==="
console-font

echo "=== Package manager safety ==="
setup-pkg-safety

echo "=== Done ==="
