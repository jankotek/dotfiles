#!/bin/bash
#
# Host setup — applies basic hardening to a fresh system.
#
# Installs no packages apart from the console font: CLI tools such as
# starship come from the distro (setup/host-weed-kde installs them on
# Tumbleweed).
#

if [ "$EUID" -ne 0 ]; then
    echo "Please run as root"
    exit 1
fi

set -euo pipefail

REPO_DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"

# The checkout is linked into /usr/local and /etc/profile.d, so root runs it
# from then on. On a real host it must be root-owned (VMs get it as a mount
# owned by the host user).
if ! systemd-detect-virt -q -v \
        && [[ -n $(find "$REPO_DIR" -maxdepth 0 ! -user root -print; \
                   find "$REPO_DIR/usr" "$REPO_DIR/setup" ! -user root -print -quit) ]]; then
    echo "ERROR: ${REPO_DIR} is not root-owned; run setup from a root-owned checkout such as /opt/jan" >&2
    exit 1
fi

echo "=== Setting /home permissions ==="
chmod 0755 /home
for dir in /home/*/; do
    [ -d "$dir" ] || continue
    chmod 0700 "$dir"
    echo "  $dir -> 0700"
done
echo "  /home -> 0755"

echo "=== Installing repo tools into /usr/local ==="
cp -f -s -r "${REPO_DIR}/usr/"* /usr/local
"${REPO_DIR}/setup/retire-path-util-names.sh"

echo "=== Setting console font ==="
console-font

echo "=== Package manager safety ==="
setup-pkg-safety

echo "=== NetworkManager ignores tailscale0 ==="
setup-nm-tailscale

echo "=== Done ==="
