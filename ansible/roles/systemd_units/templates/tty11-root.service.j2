[Unit]
Description=Root terminal on TTY11

[Service]
ExecStart=-/bin/bash
TTYPath=/dev/tty11
Type=simple
User=root
StandardInput=tty-force
StandardOutput=tty
StandardError=tty
Restart=always
RestartSec=0
KillMode=control-group
IgnoreSIGPIPE=no
TimeoutStopSec=1
KillSignal=SIGKILL

[Install]
WantedBy=multi-user.target

