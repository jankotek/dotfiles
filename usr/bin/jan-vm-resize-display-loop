#!/bin/bash
#
# Watch for SPICE/virt-viewer XRandR output changes and ask the one-shot
# jan-vm-resize-display command to normalize all monitor modes and positions.

# XFCE's dedicated XDG autostart entry and the legacy delayed session fallback
# can race at login. Keep exactly one monitor per logind user session.
runtime_dir=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
if [[ ! -d "$runtime_dir" || ! -w "$runtime_dir" ]]; then
    echo "ERROR: no writable runtime directory at $runtime_dir" >&2
    exit 1
fi
exec {lock_fd}> "$runtime_dir/jan-vm-resize-display-loop.lock"
flock -n "$lock_fd" || exit 0

# Kill any spawned xev when we get a signal — without this, a SIGTERM to
# the script leaves xev running as an orphan.
trap 'pkill -P $$ xev 2>/dev/null; exit 0' INT TERM EXIT

SCRIPT_DIR=$(dirname "$(readlink -f "$0")")
RESIZE_DISPLAY="$SCRIPT_DIR/jan-vm-resize-display"
CHANGE_DELAY=0.15

resize_displays() {
    # Do not let xfdesktop save a temporary 640x480 secondary head as the
    # desktop that owns the icons while SPICE outputs are being activated.
    xfdesktop --quit 2>/dev/null || true
    sleep 0.2

    "$RESIZE_DISPLAY" 2>/dev/null || true
    xfconf-query -c xfce4-desktop \
        -p /desktop-icons/primary -n -t bool -s true \
        2>/dev/null || true

    if ! pgrep -u "$USER" -x xfdesktop >/dev/null; then
        xfdesktop >/dev/null 2>&1 &
    fi
}

resize_displays

while true; do
    xev -root -event randr \
        | grep --line-buffered 'subtype XRROutputChangeNotifyEvent' \
        | while read -r _; do
            # Give SPICE time to publish all monitor mode changes before
            # calculating and applying the combined layout.
            sleep "$CHANGE_DELAY"
            resize_displays
        done

    # If xev or X dies the pipeline returns immediately. Wait before
    # respawning to avoid a tight fork-loop when X is unavailable.
    sleep 5
done
