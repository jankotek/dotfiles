#!/usr/bin/env python3
"""Build a fresh baseweed image from the signed Tumbleweed cloud download."""
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
from herdr_tools.common import entry
if "--golden" in sys.argv[1:]:
    from vm_golden import main
elif any(arg == "--distro" or arg.startswith("--distro=") for arg in sys.argv[1:]):
    from vm_cloud import main
else:
    from vm_image import main

sys.exit(entry(main))
