#!/bin/bash
set -euo pipefail

if [ "$EUID" -ne 0 ]; then
    echo "must run as root" >&2
    exit 1
fi

# sshd keeps the first value it reads: sort before other drop-ins.
rm -f /etc/ssh/sshd_config.d/root-enable.conf
echo "PermitRootLogin yes" > /etc/ssh/sshd_config.d/00-00-jan-root-enable.conf

sshd -t
sshd -T | grep -qix 'permitrootlogin yes' \
    || { echo "ERROR: another sshd setting still overrides PermitRootLogin" >&2; exit 1; }
systemctl reload sshd 2>/dev/null || systemctl reload ssh 2>/dev/null || true
