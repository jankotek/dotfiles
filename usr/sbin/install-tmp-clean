#!/bin/bash

# service that cleans /tmp  folder on every reboot
# needed by podman, if killed it would not start on next boot due to garbage in /tmp


set -euo pipefail

if (( EUID != 0 )); then
    echo "Please run as root" >&2
    exit 1
fi

# Create the systemd service file
tee /etc/systemd/system/tmp-clean.service > /dev/null << EOF
[Unit]
Description=Clear /tmp folder on boot
DefaultDependencies=no
After=local-fs.target
# Run before tmpfiles recreates boot-time directories such as the
# pam_namespace instance parents (/tmp/tmp-inst).
Before=systemd-tmpfiles-setup.service shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
ExecStart=/usr/bin/find /tmp -mindepth 1 -xdev -delete
RemainAfterExit=yes
ProtectSystem=strict
ReadWritePaths=/tmp
NoNewPrivileges=yes

[Install]
WantedBy=sysinit.target
EOF

# Reload systemd daemon to pick up the new service file
systemctl daemon-reload

# Enable the service to start on boot
systemctl enable tmp-clean.service


