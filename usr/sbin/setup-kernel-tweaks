#!/bin/bash
#
# Kernel boot parameter tweaks: zswap (lzo), plus optional
# parameters supplied by machine-specific bootstrap scripts.
# Supports GRUB (/etc/default/grub) and systemd-boot (/etc/kernel/cmdline).
#

set -euo pipefail

# Remove the IPv6 ban installed by older versions, preserving other arguments.
remove_ipv6_ban() {
    sed -E -i ":again; s/(^|[[:space:]\"'])ipv6\\.disable=1([[:space:]\"']|$)/\\1\\2/; t again" "$1"
}

# Remove complete managed tokens before appending their desired values. Keep
# unrelated boot arguments as text; never evaluate shell content from GRUB.
converge_params() {
    local args=$1 param key pattern matched replacement
    for param in "${PARAMS[@]}"; do
        key=${param%%=*}
        key=${key//./\\.}
        pattern="(^|[[:space:]])${key}(=[^[:space:]]*)?([[:space:]]|$)"
        while [[ $args =~ $pattern ]]; do
            matched=${BASH_REMATCH[0]}
            replacement=${BASH_REMATCH[1]}
            args=${args/"$matched"/"$replacement"}
        done
        args=${args%"${args##*[![:space:]]}"}
        args+="${args:+ }$param"
    done
    printf '%s\n' "$args"
}

update_cmdline_file() (
    local file=$1 mode=$2 line value found=0 temp
    local grub_start="^([[:space:]]*GRUB_CMDLINE_LINUX_DEFAULT=)([\"'])"
    temp=$(mktemp "${file}.tmp.XXXXXX")
    trap 'rm -f "$temp"' EXIT
    cp -p "$file" "$temp"
    : > "$temp"
    while IFS= read -r line || [[ -n $line ]]; do
        if [[ $mode == grub && $line =~ ^[[:space:]]*GRUB_CMDLINE_LINUX_DEFAULT= ]]; then
            [[ $line =~ $grub_start ]] || {
                echo "Unsupported GRUB command-line assignment in $file" >&2
                return 1
            }
            local prefix=${BASH_REMATCH[1]} quote=${BASH_REMATCH[2]} suffix rest char
            local offset escaped=0 closing=-1
            rest=${line:${#prefix}+1}
            # Find the actual shell closing quote, not a quote in an inline
            # comment. Support escaped quotes in double-quoted assignments.
            for (( offset=0; offset<${#rest}; offset++ )); do
                char=${rest:offset:1}
                if (( escaped )); then
                    escaped=0
                elif [[ $quote == '"' && $char == \\ ]]; then
                    escaped=1
                elif [[ $char == "$quote" ]]; then
                    closing=$offset
                    break
                fi
            done
            if (( closing < 0 )); then
                echo "Unterminated GRUB command-line assignment in $file" >&2
                return 1
            fi
            suffix=${rest:closing+1}
            [[ $suffix =~ ^[[:space:]]*(#.*)?$ ]] || {
                echo "Unsupported GRUB command-line suffix in $file" >&2
                return 1
            }
            value=$(converge_params "${rest:0:closing}")
            line="$prefix$quote$value$quote$suffix"
            found=$((found + 1))
        elif [[ $mode == sdboot && ! $line =~ ^[[:space:]]*(#|$) ]]; then
            line=$(converge_params "$line")
            found=$((found + 1))
        fi
        printf '%s\n' "$line" >> "$temp"
    done < "$file"
    if (( found == 0 )); then
        value=$(converge_params '')
        if [[ $mode == grub ]]; then
            printf 'GRUB_CMDLINE_LINUX_DEFAULT="%s"\n' "$value" >> "$temp"
        else
            printf '%s\n' "$value" >> "$temp"
        fi
    fi
    if [[ $mode == sdboot ]] && (( found > 1 )); then
        echo "Expected one active kernel command line in $file" >&2
        return 1
    fi
    mv -f "$temp" "$file"
)

add_params_grub() {
    local grub_file=${1:-/etc/default/grub}
    local changed=0
    local dropin_dir=${2:-/etc/default/grub.d}
    local cloud_dropin="$dropin_dir/50-cloudimg-settings.cfg"
    local jan_dropin="$dropin_dir/99-jan-kernel-tweaks.cfg"

    cp -p "$grub_file" "${grub_file}.bak"
    remove_ipv6_ban "$grub_file"
    update_cmdline_file "$grub_file" grub
    cmp -s "$grub_file" "${grub_file}.bak" || changed=1

    # Ubuntu cloud images override GRUB_CMDLINE_LINUX_DEFAULT in a later
    # 50-cloudimg-settings.cfg file. Append our parameters from a final drop-in
    # instead of editing the vendor-owned cloud file.
    if [[ -f "$cloud_dropin" ]]; then
        printf '%s\n' \
            '# Managed by setup-kernel-tweaks.' \
            "GRUB_CMDLINE_LINUX_DEFAULT=\"\${GRUB_CMDLINE_LINUX_DEFAULT} ${PARAMS[*]}\"" \
            > "$jan_dropin"
        chmod 0644 "$jan_dropin"
        changed=1
    fi

    if [[ $changed -eq 0 ]]; then
        echo "Already configured in $grub_file"
    else
        echo "Updated $grub_file (backup at ${grub_file}.bak)"
        grep CMDLINE "$grub_file"
    fi

    # Always regenerate the bootloader output. The source configuration may be
    # correct while grub.cfg is stale or was replaced by an image build.
    if command -v update-grub &>/dev/null; then
        update-grub
    elif command -v grub2-mkconfig &>/dev/null; then
        grub2-mkconfig -o /boot/grub2/grub.cfg
    fi
}

add_params_sdboot() {
    local cmdline_file=${1:-/etc/kernel/cmdline}
    local changed=0

    if ! command -v sdbootutil &>/dev/null; then
        echo "ERROR: sdbootutil is not installed"
        exit 1
    fi

    cp -p "$cmdline_file" "${cmdline_file}.bak"
    remove_ipv6_ban "$cmdline_file"
    update_cmdline_file "$cmdline_file" sdboot
    cmp -s "$cmdline_file" "${cmdline_file}.bak" || changed=1

    if [[ $changed -eq 0 ]]; then
        echo "Already configured in $cmdline_file"
    else
        echo "Updated $cmdline_file (backup at ${cmdline_file}.bak)"
        cat "$cmdline_file"
    fi

    # Keep generated entry files converged even when /etc/kernel/cmdline was
    # already correct before this run.
    sdbootutil update-all-entries
}

main() {
    if (( EUID != 0 )); then
        echo "Please run as root" >&2
        return 1
    fi
    PARAMS=(zswap.enabled=1 zswap.compressor=lzo "$@")
    local param
    for param in "${PARAMS[@]}"; do
        [[ $param =~ ^[a-zA-Z0-9_.-]+(=[a-zA-Z0-9_,:./+-]*)?$ ]] || {
            echo "Unsupported kernel parameter: $param" >&2
            return 2
        }
    done
    if [[ -f /etc/kernel/cmdline ]]; then
        add_params_sdboot
    elif [[ -f /etc/default/grub ]]; then
        add_params_grub
    else
        echo "No supported bootloader config found" >&2
        return 1
    fi
    echo "Reboot to apply changes (including restoring IPv6)."
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
    main "$@"
fi
