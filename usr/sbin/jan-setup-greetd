#!/bin/bash
# Install and configure greetd + tuigreet on tty3 through tty10.
#
# tty1 and tty2 remain under systemd's normal getty/autovt policy for recovery.
# Each greetd instance uses the distro PAM stack, so pam_systemd registers real
# logind sessions and greetd can terminate them cleanly during system shutdown.

set -Eeuo pipefail

readonly -a GREETD_TTYS=(3 4 5 6 7 8 9 10)
readonly -a EXCLUDED_GREETD_TTYS=(11 12)
readonly FIRST_GREETD_TTY=3

error_trap() {
    local rc=$?
    echo >&2 "${BASH_SOURCE[1]}:${BASH_LINENO[0]}: Command \`$BASH_COMMAND\` failed with exit code $rc"
    exit "$rc"
}
trap error_trap ERR

if (( EUID != 0 )); then
    echo "ERROR: jan-setup-greetd must run as root" >&2
    exit 1
fi

if [[ ! -d /run/systemd/system ]]; then
    echo "ERROR: jan-setup-greetd requires systemd as PID 1" >&2
    exit 1
fi

# shellcheck source=/dev/null
source /etc/os-release
if [[ "${ID:-}" != opensuse-tumbleweed ]]; then
    echo "ERROR: jan-setup-greetd currently targets openSUSE Tumbleweed" >&2
    exit 1
fi

# Validate both emergency-console aliases before making any system changes.
# A mask on either template prevents logind from supplying the promised text
# login, so preserve administrator state and fail early rather than unmasking it.
for tty in 1 2; do
    for template in getty autovt; do
        unit="${template}@tty${tty}.service"
        state=$(systemctl is-enabled "$unit" 2>/dev/null || true)
        if [[ $state == masked || $state == masked-runtime ]]; then
            echo "ERROR: emergency $unit is already masked" >&2
            exit 1
        fi
    done
done

echo "==> Installing greetd, tuigreet, and X11 session helpers"
zypper -n install --no-recommends greetd tuigreet xinit dbus-1-tools

readonly GREETD_BIN=/usr/bin/greetd
readonly TUIGREET_BIN=/usr/bin/tuigreet
readonly CHVT_BIN=/usr/bin/chvt
readonly SESSION_WRAPPER=/usr/local/bin/jan-greetd-session
readonly FLOCK_BIN=/usr/bin/flock
readonly STARTX_BIN=/usr/bin/startx
readonly DBUS_UPDATE_BIN=/usr/bin/dbus-update-activation-environment

for command_path in \
    "$GREETD_BIN" \
    "$TUIGREET_BIN" \
    "$CHVT_BIN" \
    "$SESSION_WRAPPER" \
    "$FLOCK_BIN" \
    "$STARTX_BIN" \
    "$DBUS_UPDATE_BIN"; do
    if [[ ! -x "$command_path" ]]; then
        echo "ERROR: required executable is missing: $command_path" >&2
        exit 1
    fi
done

if ! getent passwd greeter >/dev/null; then
    echo "ERROR: the greetd package did not create the greeter account" >&2
    exit 1
fi

# On Tumbleweed the vendor greetd PAM service includes common-session, whose
# pam_systemd entry creates session-N.scope, /run/user/UID, and the user systemd
# manager. Refuse to deploy if that integration has been removed locally.
greetd_pam=
for candidate in /etc/pam.d/greetd /usr/etc/pam.d/greetd /usr/lib/pam.d/greetd; do
    if [[ -r "$candidate" ]]; then
        greetd_pam=$candidate
        break
    fi
done
if [[ -z "$greetd_pam" ]]; then
    echo "ERROR: greetd PAM service is missing" >&2
    exit 1
fi

if grep -Eq '^[[:space:]]*session[[:space:]].*pam_systemd\.so([[:space:]]|$)' "$greetd_pam"; then
    :
elif grep -Eq '^[[:space:]]*session[[:space:]]+(include|substack)[[:space:]]+common-session([[:space:]]|$)' "$greetd_pam" \
    && grep -Eq '^[[:space:]]*session[[:space:]].*pam_systemd\.so([[:space:]]|$)' /etc/pam.d/common-session; then
    :
else
    echo "ERROR: the greetd PAM session stack does not include pam_systemd.so" >&2
    echo "       repair Tumbleweed's common-session PAM configuration first" >&2
    exit 1
fi

install -d -m 0755 /etc/greetd
install -d -m 0755 /etc/systemd/logind.conf.d

# Keep logind's automatic text consoles strictly on the two recovery VTs.
# ReserveVT=2 makes tty2 eagerly available even though tty3 becomes the active
# console after graphical.target starts.
cat > /etc/systemd/logind.conf.d/80-jan-greetd-vts.conf <<'EOF'
[Login]
NAutoVTs=2
ReserveVT=2
EOF
chmod 0644 /etc/systemd/logind.conf.d/80-jan-greetd-vts.conf

# Refuse to continue if a later administrator drop-in overrides the recovery
# VT policy. systemd-analyze emits files in effective precedence order, so the
# final assignment in [Login] is authoritative.
effective_logind_value() {
    local key=$1
    systemd-analyze cat-config systemd/logind.conf | awk -F= -v wanted="$key" '
        /^[[:space:]]*#/ || /^[[:space:]]*$/ { next }
        /^[[:space:]]*\[Login\][[:space:]]*$/ { in_login = 1; next }
        /^[[:space:]]*\[/ { in_login = 0; next }
        in_login {
            name = $1
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", name)
            if (name == wanted) {
                value = substr($0, index($0, "=") + 1)
                sub(/[[:space:]]*[#;].*$/, "", value)
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
            }
        }
        END { print value }
    '
}

if [[ $(effective_logind_value NAutoVTs) != 2 || $(effective_logind_value ReserveVT) != 2 ]]; then
    echo "ERROR: a later logind configuration overrides NAutoVTs=2 or ReserveVT=2" >&2
    exit 1
fi

# Reconcile the previous/manual out-of-range layout before tty12-menu is
# started by host-weed-kde. These exact names belong to jan-setup-greetd.
echo "==> Removing stale greetd ownership from tty11 and tty12"
for tty in "${EXCLUDED_GREETD_TTYS[@]}"; do
    stale_unit="greetd-tty${tty}.service"
    systemctl disable --now "$stale_unit" 2>/dev/null || true
    if systemctl is-active --quiet "$stale_unit"; then
        echo "ERROR: could not stop stale $stale_unit" >&2
        exit 1
    fi
    rm -f -- \
        "/etc/systemd/system/${stale_unit}" \
        "/etc/systemd/system/graphical.target.wants/${stale_unit}" \
        "/etc/systemd/system/multi-user.target.wants/${stale_unit}" \
        "/etc/greetd/config-tty${tty}.toml"
done

echo "==> Writing per-VT greetd configurations and services"
for tty in "${GREETD_TTYS[@]}"; do
    config="/etc/greetd/config-tty${tty}.toml"
    unit="/etc/systemd/system/greetd-tty${tty}.service"

    cat > "$config" <<EOF
[terminal]
vt = $tty
switch = false

[general]
service = "greetd"
source_profile = true
runfile = "/run/greetd-tty${tty}.run"

[default_session]
command = "$TUIGREET_BIN --time --sessions /usr/share/wayland-sessions --session-wrapper '$SESSION_WRAPPER wayland' --xsessions /usr/share/xsessions --xsession-wrapper '$SESSION_WRAPPER x11' --power-shutdown 'systemctl poweroff' --power-reboot 'systemctl reboot'"
user = "greeter"
EOF
    chmod 0644 "$config"

    cat > "$unit" <<EOF
[Unit]
Description=greetd login manager on tty$tty
Wants=systemd-logind.service
After=systemd-user-sessions.service systemd-logind.service plymouth-quit-wait.service getty@tty${tty}.service autovt@tty${tty}.service
Conflicts=getty@tty${tty}.service autovt@tty${tty}.service
StartLimitIntervalSec=30s
StartLimitBurst=5

[Service]
Type=simple
ExecStart=$GREETD_BIN --config $config --vt $tty
IgnoreSIGPIPE=no
SendSIGHUP=yes
KeyringMode=shared
Restart=always
RestartSec=1s
TimeoutStopSec=30s

[Install]
WantedBy=graphical.target
EOF
    chmod 0644 "$unit"
done

# All greetd instances use switch=false to avoid a boot-time VT race. Once all
# eight daemons are ready and waiting for their VT, switch exactly once to tty3.
cat > /etc/systemd/system/jan-greetd-switch-tty3.service <<EOF
[Unit]
Description=Switch to the primary greetd console
After=$(printf 'greetd-tty%s.service ' "${GREETD_TTYS[@]}")
Wants=$(printf 'greetd-tty%s.service ' "${GREETD_TTYS[@]}")

[Service]
Type=oneshot
ExecStart=$CHVT_BIN $FIRST_GREETD_TTY
RemainAfterExit=yes

[Install]
WantedBy=graphical.target
EOF
chmod 0644 /etc/systemd/system/jan-greetd-switch-tty3.service

systemctl daemon-reload

echo "==> Validating generated systemd units"
systemd-analyze verify \
    /etc/systemd/system/greetd-tty{3,4,5,6,7,8,9,10}.service \
    /etc/systemd/system/jan-greetd-switch-tty3.service

echo "==> Reserving tty3-tty10 for greetd"
for tty in "${GREETD_TTYS[@]}"; do
    systemctl mask --force "getty@tty${tty}.service"
    systemctl mask --force "autovt@tty${tty}.service"
    # reenable removes stale multi-user.target links from the old unit layout.
    systemctl reenable "greetd-tty${tty}.service"
done

echo "==> Masking competing display managers"
readonly -a COMPETING_DMS=(
    display-manager.service
    display-manager-legacy.service
    greetd.service
    sddm.service
    lightdm.service
    gdm.service
    gdm3.service
    xdm.service
    lxdm.service
)
for unit in "${COMPETING_DMS[@]}"; do
    systemctl disable "$unit" 2>/dev/null || true
    systemctl mask --force "$unit"
done

systemctl enable jan-greetd-switch-tty3.service
systemctl set-default graphical.target

echo "=========== HOST GREETD SETUP DONE ==========="
echo "Reboot to start tuigreet on tty3-tty10; tty1 and tty2 remain text consoles."
