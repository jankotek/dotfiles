    sum=$(fetch_checksum "https://corretto.aws/downloads/latest_sha256/amazon-corretto-${jdk_version}-x64-linux-jdk.tar.gz") || true
    [ -n "$sum" ] || { echo "✗ Failed to fetch checksum for Corretto JDK ${jdk_version}"; return 1; }

