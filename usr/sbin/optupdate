install_yq() {
    local version idx
    version=$(github_api https://api.github.com/repos/mikefarah/yq/releases/latest | grep -oP '"tag_name": "\K[^"]+') || true
    local base="https://github.com/mikefarah/yq/releases/download/${version}"
    local url="${base}/yq_linux_amd64"
    # yq's "checksums" file has one row per file and one column per hash
    # algorithm; the column order is published in checksums_hashes_order.
    idx=$(curl -fLsS "${base}/checksums_hashes_order" 2>/dev/null | grep -nx 'SHA-256' | cut -d: -f1) || true
    local sum=""
    [ -n "$idx" ] && sum=$(curl -fLsS "${base}/checksums" 2>/dev/null \
        | awk -v c=$((idx + 1)) '$1 == "yq_linux_amd64" { print tolower($c); exit }' \
        | grep -E '^[0-9a-f]{64}$' || true)
    [ -n "$sum" ] || { echo "✗ Failed to fetch checksum for yq"; return 1; }
    download_single_binary "yq" "yq" "$url" "$version" "$sum"
}

install_ffmpeg() {
    # BtbN dropped nonfree builds; gpl is the closest remaining variant.
    local version sum
    version=$(github_api https://api.github.com/repos/BtbN/FFmpeg-Builds/releases/latest | grep -oP '"tag_name": "\K[^"]+') || true
    local file="ffmpeg-master-latest-linux64-gpl.tar.xz"
    local url="https://github.com/BtbN/FFmpeg-Builds/releases/download/${version}/${file}"

    if [ -z "$version" ]; then
        echo "✗ Failed to fetch version for FFmpeg"
        return 1
    fi

    sum=$(fetch_checksum "https://github.com/BtbN/FFmpeg-Builds/releases/download/${version}/checksums.sha256" "$file") || true
    [ -n "$sum" ] || { echo "✗ Failed to fetch checksum for FFmpeg"; return 1; }

    download_and_extract "FFmpeg" "ffmpeg" "$url" "$version" 1 "$sum" "bin/ffmpeg" \
        "bin/ffplay bin/ffprobe"
}

# Default install set; pass tool names as arguments to install a subset.
ALL_TOOLS=(idea nushell herdr codex pi claude obsidian fresh gradle maven
           kubectl kind k9s helm stern skaffold jq yq ffmpeg corretto_all)

if [ $# -gt 0 ]; then
    TOOLS=("$@")
else
    TOOLS=("${ALL_TOOLS[@]}")
fi

for tool in "${TOOLS[@]}"; do
    if ! declare -F "install_${tool}" >/dev/null; then
        echo "✗ Unknown tool: $tool (available: ${ALL_TOOLS[*]})"
        exit 1
    fi
done

# Defense in depth: nothing optupdate manages may keep a setuid or setgid bit,
# including trees installed by older versions. Other /opt software (browser
# sandboxes from vendor packages) is left alone. Runs before the installs, so a
# failing tool cannot leave a legacy setuid file behind, and again after them.
sweep_setuid_bits() {
    local path privileged
    local -a managed_paths=()
    for path in idea nushell codex pi claude obsidian gradle maven k9s helm \
        stern ffmpeg jdk bin .versions applications; do
        [ -e "$BASE_DIR/$path" ] && managed_paths+=("$BASE_DIR/$path")
    done
    [ "${#managed_paths[@]}" -gt 0 ] || return 0
    while IFS= read -r -d '' privileged; do
        echo "⚠ Removing setuid/setgid bit: $privileged"
        chmod ug-s -- "$privileged"
    done < <(find "${managed_paths[@]}" -xdev \( -perm -4000 -o -perm -2000 \) ! -type l -print0)
}

sweep_setuid_bits

# Grok and Mjolnir are no longer managed; remove what older versions installed
# (only trees and links that carry optupdate's own markers).
if [ -f "$BASE_DIR/.versions/grok" ]; then
    rm -f -- "$BASE_DIR/bin/grok" "$BASE_DIR/.versions/grok" "$BASE_DIR/.versions/grok.sha256"
    echo "→ Removed the retired Grok CLI"
fi
if [ -f "$BASE_DIR/mjolnir/.version" ] && [ ! -L "$BASE_DIR/mjolnir" ]; then
    rm -rf -- "$BASE_DIR/mjolnir"
    echo "→ Removed the retired Mjolnir bundle"
fi
if [ -L "$BASE_DIR/bin/mj" ] && [ "$(readlink -- "$BASE_DIR/bin/mj")" = "$BASE_DIR/mjolnir/mj" ]; then
    rm -f -- "$BASE_DIR/bin/mj"
fi

echo "Starting software installation in $BASE_DIR..."
for tool in "${TOOLS[@]}"; do
    "install_${tool}"
done

mkdir -p "$BASE_DIR/bin"
chmod 0755 "$BASE_DIR/bin"
[ -f "$BASE_DIR/gradle/bin/gradle" ] && ln -sf "$BASE_DIR/gradle/bin/gradle" "$BASE_DIR/bin/gradle"
[ -f "$BASE_DIR/maven/bin/mvn" ] && ln -sf "$BASE_DIR/maven/bin/mvn" "$BASE_DIR/bin/mvn"
[ -f "$BASE_DIR/nushell/nu" ] && ln -sf "$BASE_DIR/nushell/nu" "$BASE_DIR/bin/nu"
[ -f "$BASE_DIR/k9s/k9s" ] && ln -sf "$BASE_DIR/k9s/k9s" "$BASE_DIR/bin/k9s"
[ -f "$BASE_DIR/helm/helm" ] && ln -sf "$BASE_DIR/helm/helm" "$BASE_DIR/bin/helm"
[ -f "$BASE_DIR/stern/stern" ] && ln -sf "$BASE_DIR/stern/stern" "$BASE_DIR/bin/stern"
[ -f "$BASE_DIR/idea/bin/idea.sh" ] && ln -sf "$BASE_DIR/idea/bin/idea.sh" "$BASE_DIR/bin/idea"
if [ -f "$BASE_DIR/obsidian/obsidian" ]; then
    # The setuid bit on Electron's chrome-sandbox helper is stripped, so
    # Obsidian sandboxes itself with unprivileged user namespaces. Ubuntu's
    # AppArmor denies those to unconfined programs; only there does the
    # launcher fall back to --no-sandbox. Decided at run time because VMs may
    # share this /opt with a host running a different distribution.
    obsidian_bin=$(printf '%q' "$BASE_DIR/obsidian/obsidian")
    rm -f -- "$BASE_DIR/bin/obsidian.new"
    cat > "$BASE_DIR/bin/obsidian.new" <<EOF
#!/bin/sh
# Generated by optupdate.
if [ "\$(cat /proc/sys/kernel/apparmor_restrict_unprivileged_userns 2>/dev/null)" = 1 ]; then
    exec $obsidian_bin --no-sandbox "\$@"
fi
exec $obsidian_bin "\$@"
EOF
    chmod 0755 "$BASE_DIR/bin/obsidian.new"
    mv -f -- "$BASE_DIR/bin/obsidian.new" "$BASE_DIR/bin/obsidian"
fi
[ -f "$BASE_DIR/ffmpeg/bin/ffmpeg" ] && ln -sf "$BASE_DIR/ffmpeg/bin/ffmpeg" "$BASE_DIR/bin/ffmpeg"
[ -f "$BASE_DIR/ffmpeg/bin/ffplay" ] && ln -sf "$BASE_DIR/ffmpeg/bin/ffplay" "$BASE_DIR/bin/ffplay"
[ -f "$BASE_DIR/ffmpeg/bin/ffprobe" ] && ln -sf "$BASE_DIR/ffmpeg/bin/ffprobe" "$BASE_DIR/bin/ffprobe"
[ -f "$BASE_DIR/codex/bin/codex" ] && ln -sf "$BASE_DIR/codex/bin/codex" "$BASE_DIR/bin/codex"
[ -f "$BASE_DIR/pi/pi" ] && ln -sf "$BASE_DIR/pi/pi" "$BASE_DIR/bin/pi"
[ -f "$BASE_DIR/claude/claude" ] && ln -sf "$BASE_DIR/claude/claude" "$BASE_DIR/bin/claude"

sweep_setuid_bits

cat > "$BASE_DIR/env.sh" <<EOF
# Generated by optupdate
export PATH="\$PATH:$BASE_DIR/bin"
EOF
chmod 0644 "$BASE_DIR/env.sh"

echo ""
echo "All software installed successfully!"
echo "Base directory: $BASE_DIR"
[ "$EUID" -ne 0 ] && echo "Desktop files: $DESKTOP_DIR"
echo ""
echo "To use installed tools, add this to your shell config:"
echo "  source $BASE_DIR/env.sh"
