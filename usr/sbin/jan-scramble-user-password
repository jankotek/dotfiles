#!/bin/bash

# Check if the script is run as root
if [ "$EUID" -ne 0 ]; then
    echo "This script must be run as root"
    exit 1
fi

# Check if username is provided
if [ -z "$1" ]; then
    echo "Usage: $0 <username>"
    exit 1
fi

USERNAME="$1"
PASSWORD_FILE="/root/pw-${USERNAME}.txt"

# Generate random 128-character alphanumeric password
PASSWORD=$(LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c128)

# Save password to file (root-only)
(umask 077 && printf '%s\n' "$PASSWORD" > "$PASSWORD_FILE")
chmod 600 "$PASSWORD_FILE"

# Change user password
if ! printf '%s:%s\n' "$USERNAME" "$PASSWORD" | chpasswd; then
    exit 1
fi