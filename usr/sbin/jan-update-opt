#!/bin/bash
set -e
set -o pipefail

# GitHub API token (optional, increases rate limit from 60 to 5000 requests/hour)
GITHUB_API_TOKEN="${GITHUB_API_TOKEN:-}"

BASE_DIR="${JAN_OPT:-/opt}"
if [ ! -w "$BASE_DIR" ]; then
    echo "✗ Error: $BASE_DIR is not writeable by current user"
    echo "  Set JAN_OPT to a writeable directory or run with appropriate permissions"
    exit 1
fi

DESKTOP_DIR="$BASE_DIR/applications"
mkdir -p "$DESKTOP_DIR"
chmod 0755 "$BASE_DIR" "$DESKTOP_DIR"

# Helper function for GitHub API calls with optional authentication
github_api() {
    if [ -n "$GITHUB_API_TOKEN" ]; then
        curl -sL -H "Authorization: token $GITHUB_API_TOKEN" "$@"
    else
        curl -sL "$@"
    fi
}

# Download an artifact body. aria2c handles retries, partial transfers, and
# multiple connections; curl remains a fallback for minimally provisioned
# systems. Metadata and checksum requests stay on curl elsewhere in this file.
download_file() {
    local url=$1 output=$2
    if command -v aria2c >/dev/null 2>&1; then
        aria2c \
            --allow-overwrite=true \
            --auto-file-renaming=false \
            --continue=true \
            --connect-timeout=15 \
            --file-allocation=none \
            --max-connection-per-server=4 \
            --max-tries=5 \
            --min-split-size=1M \
            --retry-wait=2 \
            --split=4 \
            --summary-interval=0 \
            --console-log-level=warn \
            --dir="$(dirname -- "$output")" \
            --out="$(basename -- "$output")" \
            "$url"
    else
        curl -fLsS --retry 4 --retry-all-errors "$url" -o "$output"
    fi
}

# GitHub may return either pretty-printed or compact JSON depending on the
# client/CDN path. Normalize both forms before extracting release metadata;
# target systems should not need jq just to run this downloader.
github_release_tag() {
    tr -d '\n\r' <<<"$1" \
        | grep -oP '"tag_name"\s*:\s*"\K[^"]+' \
        | head -1
}

# github_asset_sha256 <release-json> <asset-filename>
# GitHub calculates a SHA-256 digest for every release asset. Match the exact
# asset name and take the first digest that follows it (the nested uploader
# object between those fields is why a line-oriented parser is insufficient).
github_asset_sha256() {
    local release=$1 file=$2
    tr -d '\n\r' <<<"$release" \
        | grep -oP "\"name\"\\s*:\\s*\"\\Q${file}\\E\".*?\"digest\"\\s*:\\s*\"sha256:\\K[0-9a-f]{64}" \
        | head -1
}

# ---------- checksum verification ----------
# Every download is verified against a checksum published by the same project
# (fetched at run time, since versions are not pinned). This protects against
# corrupted downloads and CDN/mirror tampering — not against a fully
# compromised publisher, which would require signature verification.

# fetch_checksum <url> [filename] [hexlen]
# Print the lowercase hex digest published at <url>. Handles bare-digest files
# and sum-style lists ("<hash>  <file>", "<file> <hash>...", "<hash> *<file>",
# "<hash> ./<file>"); with <filename> only the matching line is considered.
# hexlen defaults to 64 (SHA-256); pass 128 for SHA-512.
# Prints nothing on failure — callers must treat empty output as fatal.
fetch_checksum() {
    local url=$1 fname=${2:-} hexlen=${3:-64}
    curl -fLsS "$url" 2>/dev/null | awk -v f="$fname" -v len="$hexlen" '
        f != "" {
            ok = 0
            for (i = 1; i <= NF; i++)
                if ($i == f || $i == "*" f || $i == "./" f) ok = 1
            if (!ok) next
        }
        {
            for (i = 1; i <= NF; i++)
                if (length($i) == len && $i ~ /^[0-9a-fA-F]+$/) {
                    print tolower($i)
                    exit
                }
        }'
}

# verify_file <file> <expected>
# <expected> is a sha256 hex digest, "sha512:<hex>" for sha512, or "md5:<hex>".
verify_file() {
    local file=$1 expected=$2 algo=sha256
    if [[ "$expected" == sha512:* ]]; then
        algo=sha512
        expected=${expected#sha512:}
    elif [[ "$expected" == md5:* ]]; then
        algo=md5
        expected=${expected#md5:}
    fi
    expected=${expected,,}
    local actual
    actual=$("${algo}sum" "$file" | awk '{print $1}')
    if [ "$actual" != "$expected" ]; then
        echo "✗ Checksum mismatch ($algo) for $file"
        echo "  expected: $expected"
        echo "  actual:   $actual"
        return 1
    fi
    echo "  ✓ $algo verified"
}

installed_binary_matches() {
    local file=$1 digest_file=$2 expected actual
    [ -f "$file" ] && [ ! -L "$file" ] && [ -x "$file" ] && [ -s "$file" ] || return 1
    [ -s "$digest_file" ] || return 1
    expected=$(<"$digest_file")
    [[ "$expected" =~ ^[0-9a-f]{64}$ ]] || return 1
    actual=$(sha256sum "$file" | awk '{print $1}')
    [ "$actual" = "$expected" ]
}

make_shared_directory() {
    mkdir -p "$1"
    chmod 0755 "$1"
}

acquire_tool_lock() {
    local key=$1 fd_var=$2 lock_dir="$BASE_DIR/.jan-update-locks" fd
    make_shared_directory "$lock_dir"
    exec {fd}>"$lock_dir/${key//\//_}.lock"
    flock "$fd"
    printf -v "$fd_var" '%s' "$fd"
}

activate_staged_directory() {
    local staged=$1 final=$2 key=$3
    local backup="$BASE_DIR/.jan-update-${key//\//_}.backup.$$.$RANDOM"

    make_shared_directory "$(dirname "$final")"
    if [ -e "$final" ] || [ -L "$final" ]; then
        mv -T "$final" "$backup"
    else
        backup=
    fi
    if ! mv -T "$staged" "$final"; then
        [ -n "$backup" ] && mv -T "$backup" "$final"
        return 1
    fi
    [ -z "$backup" ] || rm -rf "$backup"
}

# expected is an archive checksum; executable is the required path after
# extraction. The lock intentionally covers the whole small transaction.
download_and_extract() (
    set -e
    set -o pipefail
    local name=$1 dir=$2 url=$3 version=$4 strip=${5:-1}
    local expected=${6:-} executable=${7:-}
    local final="$BASE_DIR/$dir" version_file="$BASE_DIR/$dir/.version"
    local digest_file="$BASE_DIR/$dir/.installed-sha256"
    local current_version="" lock_fd temp_dir

    [ -n "$version" ] || { echo "✗ Failed to fetch version for $name"; return 1; }
    acquire_tool_lock "$dir" lock_fd
    : "$lock_fd"
    [ -f "$version_file" ] && current_version=$(<"$version_file")
    if [ "$current_version" = "$version" ]         && installed_binary_matches "$final/$executable" "$digest_file"; then
        echo "✓ $name already at version $version"
        return 0
    fi
    [ "$current_version" != "$version" ]         || echo "→ Repairing incomplete $name $version installation"

    echo "→ Downloading $name $version..."
    temp_dir=$(mktemp -d "$BASE_DIR/.jan-update-${dir//\//_}.staging.XXXXXX")
    trap 'rm -rf "$temp_dir"' EXIT
    download_file "$url" "$temp_dir/archive.tar.gz"
    if [ -n "$expected" ]; then
        verify_file "$temp_dir/archive.tar.gz" "$expected"
    else
        echo "  ⚠ $name: publisher provides no checksum — installing unverified"
    fi
    tar xzf "$temp_dir/archive.tar.gz" -C "$temp_dir"         --strip-components="$strip" --no-same-owner
    rm "$temp_dir/archive.tar.gz"
    rm -rf -- "$temp_dir/.version" "$temp_dir/.installed-sha256"

    if [ -z "$executable" ] || [ ! -f "$temp_dir/$executable" ]         || [ -L "$temp_dir/$executable" ] || [ ! -s "$temp_dir/$executable" ]; then
        echo "✗ $name archive does not contain expected executable: $executable"
        return 1
    fi
    chmod -R a-s,a-t,u+rwX,go+rX,go-w "$temp_dir"
    chmod 0755 "$temp_dir" "$temp_dir/$executable"
    sha256sum "$temp_dir/$executable" | awk '{print $1}' > "$temp_dir/.installed-sha256"
    printf '%s\n' "$version" > "$temp_dir/.version"
    chmod 0644 "$temp_dir/.version" "$temp_dir/.installed-sha256"

    activate_staged_directory "$temp_dir" "$final" "$dir"
    temp_dir=
    trap - EXIT
    echo "✓ $name $version installed"
)

download_zstd_binary_to_dir() (
    set -e
    set -o pipefail
    local name=$1 dir=$2 binary=$3 url=$4 version=$5
    local archive_expected=$6 binary_expected=$7 expected_size=${8:-}
    local final="$BASE_DIR/$dir" version_file="$BASE_DIR/$dir/.version"
    local current_version="" lock_fd temp_dir

    [ -n "$version" ] || { echo "✗ Failed to fetch version for $name"; return 1; }
    command -v zstd >/dev/null         || { echo "✗ zstd is required to install the native $name archive"; return 1; }
    acquire_tool_lock "$dir" lock_fd
    : "$lock_fd"
    [ -f "$version_file" ] && current_version=$(<"$version_file")
    if [ "$current_version" = "$version" ]         && [ -f "$final/$binary" ] && [ ! -L "$final/$binary" ]         && [ -x "$final/$binary" ]         && [ "$(sha256sum "$final/$binary" | awk '{print $1}')" = "$binary_expected" ]; then
        echo "✓ $name already at version $version"
        return 0
    fi
    [ "$current_version" != "$version" ]         || echo "→ Repairing incomplete $name $version installation"

    echo "→ Downloading $name $version..."
    temp_dir=$(mktemp -d "$BASE_DIR/.jan-update-${dir//\//_}.staging.XXXXXX")
    trap 'rm -rf "$temp_dir"' EXIT
    download_file "$url" "$temp_dir/$binary.zst"
    verify_file "$temp_dir/$binary.zst" "$archive_expected"
    zstd -q -d -c "$temp_dir/$binary.zst" > "$temp_dir/$binary"
    rm "$temp_dir/$binary.zst"
    if [ -n "$expected_size" ]         && [ "$(stat -c %s "$temp_dir/$binary")" != "$expected_size" ]; then
        echo "✗ Size mismatch for decompressed $name executable"
        return 1
    fi
    verify_file "$temp_dir/$binary" "$binary_expected"
    chmod 0755 "$temp_dir" "$temp_dir/$binary"
    printf '%s\n' "$version" > "$temp_dir/.version"
    chmod 0644 "$temp_dir/.version"

    activate_staged_directory "$temp_dir" "$final" "$dir"
    temp_dir=
    trap - EXIT
    echo "✓ $name $version installed"
)


create_desktop_file() {
    local filename=$1 name=$2 exec=$3 icon=$4 comment=$5
    cat > "$DESKTOP_DIR/$filename.desktop" <<EOF
[Desktop Entry]
Version=1.0
Type=Application
Name=$name
Comment=$comment
Exec=$exec
Icon=$icon
Terminal=false
Categories=Development;
EOF
    chmod 0755 "$DESKTOP_DIR/$filename.desktop"
}

install_idea() {
    # The releases API is the source of truth for both the download URL and
    # its checksum (download filenames changed from ideaIC-* to idea-*).
    local json=$(curl -s 'https://data.services.jetbrains.com/products/releases?code=IIC&latest=true&type=release')
    local version=$(grep -oP '"version":"\K[^"]+' <<<"$json" | head -1)
    local url=$(grep -oP '"link":"\K[^"]+\.tar\.gz' <<<"$json" | grep -v aarch64 | head -1)
    local sum_url=$(grep -oP '"checksumLink":"\K[^"]+\.tar\.gz\.sha256' <<<"$json" | grep -v aarch64 | head -1)
    local sum=$(fetch_checksum "$sum_url")
    if [ -z "$url" ] || [ -z "$sum" ]; then
        echo "✗ Failed to fetch download/checksum info for IntelliJ IDEA"
        return 1
    fi
    download_and_extract "IntelliJ IDEA" "idea" "$url" "$version" 1 "$sum" "bin/idea.sh"
    create_desktop_file "intellij-idea" "IntelliJ IDEA" "$BASE_DIR/idea/bin/idea.sh" "$BASE_DIR/idea/bin/idea.svg" "IntelliJ IDEA"
}

install_nushell() {
    local version=$(github_api https://api.github.com/repos/nushell/nushell/releases/latest | grep -oP '"tag_name": "\K[^"]+')
    local file="nu-${version}-x86_64-unknown-linux-musl.tar.gz"
    local url="https://github.com/nushell/nushell/releases/download/${version}/${file}"
    local sum=$(fetch_checksum "https://github.com/nushell/nushell/releases/download/${version}/SHA256SUMS" "$file")
    [ -n "$sum" ] || { echo "✗ Failed to fetch checksum for Nushell"; return 1; }
    download_and_extract "Nushell" "nushell" "$url" "$version" 1 "$sum" "nu"
}

install_starship() {
    local version=$(github_api https://api.github.com/repos/starship/starship/releases/latest | grep -oP '"tag_name": "\K[^"]+')
    local url="https://github.com/starship/starship/releases/download/${version}/starship-x86_64-unknown-linux-musl.tar.gz"
    local sum=$(fetch_checksum "${url}.sha256")
    [ -n "$sum" ] || { echo "✗ Failed to fetch checksum for Starship"; return 1; }
    download_and_extract "Starship" "starship" "$url" "$version" 0 "$sum" "starship"
}

install_herdr() {
    local release version arch file url sum
    release=$(github_api https://api.github.com/repos/ogulcancelik/herdr/releases/latest)
    version=$(github_release_tag "$release" || true)

    case "$(uname -m)" in
        x86_64|amd64) arch=x86_64 ;;
        aarch64|arm64) arch=aarch64 ;;
        *)
            echo "✗ Herdr does not publish a Linux binary for architecture $(uname -m)"
            return 1
            ;;
    esac

    file="herdr-linux-${arch}"
    url="https://github.com/ogulcancelik/herdr/releases/download/${version}/${file}"
    # GitHub calculates and publishes a SHA-256 digest for every release
    # asset, even though Herdr does not ship a separate checksum file.
    sum=$(github_asset_sha256 "$release" "$file" || true)
    [[ "$sum" =~ ^[0-9a-f]{64}$ ]] || {
        echo "✗ Failed to fetch checksum for Herdr"
        return 1
    }

    download_single_binary "Herdr" "herdr" "$url" "$version" "$sum"
}

install_codex() {
    local release tag version arch file url sum
    release=$(github_api https://api.github.com/repos/openai/codex/releases/latest)
    tag=$(github_release_tag "$release" || true)
    version=${tag#rust-v}

    case "$(uname -m)" in
        x86_64|amd64) arch=x86_64 ;;
        aarch64|arm64) arch=aarch64 ;;
        *)
            echo "✗ Codex does not publish a Linux binary for architecture $(uname -m)"
            return 1
            ;;
    esac

    file="codex-${arch}-unknown-linux-musl.tar.gz"
    url="https://github.com/openai/codex/releases/download/${tag}/${file}"
    sum=$(github_asset_sha256 "$release" "$file" || true)
    [[ "$tag" == rust-v* && "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+ && "$sum" =~ ^[0-9a-f]{64}$ ]] || {
        echo "✗ Failed to fetch release/checksum info for Codex"
        return 1
    }

    download_and_extract "Codex CLI" "codex" "$url" "$version" 0 "$sum" \
        "codex-${arch}-unknown-linux-musl"
}

install_pi() {
    local release version arch file url sum
    release=$(github_api https://api.github.com/repos/earendil-works/pi/releases/latest)
    version=$(github_release_tag "$release" || true)
    version=${version#v}

    case "$(uname -m)" in
        x86_64|amd64) arch=x64 ;;
        aarch64|arm64) arch=arm64 ;;
        *)
            echo "✗ Pi does not publish a Linux binary for architecture $(uname -m)"
            return 1
            ;;
    esac

    file="pi-linux-${arch}.tar.gz"
    url="https://github.com/earendil-works/pi/releases/download/v${version}/${file}"
    sum=$(fetch_checksum "https://github.com/earendil-works/pi/releases/download/v${version}/SHA256SUMS" "$file")
    [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+ && "$sum" =~ ^[0-9a-f]{64}$ ]] || {
        echo "✗ Failed to fetch release/checksum info for Pi"
        return 1
    }

    # The archive has one top-level pi/ directory containing the Bun-compiled
    # executable plus the runtime assets used by extensions and exports.
    download_and_extract "Pi agent harness" "pi" "$url" "$version" 1 "$sum" "pi"
}

json_platform_value() {
    local json=$1 platform=$2 key=$3
    tr -d '\n\r\t' <<<"$json" \
        | grep -oP "\"${platform}\"\\s*:\\s*\\{[^}]*\"${key}\"\\s*:\\s*\"?\\K[0-9a-f]+" \
        | head -1
}

install_claude() {
    local base version arch platform manifest zst_manifest
    local archive_sum binary_sum binary_size url
    base="https://downloads.claude.ai/claude-code-releases"
    version=$(curl -fLsS --max-time 30 "$base/latest" 2>/dev/null \
        | tr -d '\r' | head -n1 | tr -d '[:space:]')

    case "$(uname -m)" in
        x86_64|amd64) arch=x64 ;;
        aarch64|arm64) arch=arm64 ;;
        *)
            echo "✗ Claude Code does not publish a Linux binary for architecture $(uname -m)"
            return 1
            ;;
    esac
    if [ -f /lib/libc.musl-x86_64.so.1 ] || [ -f /lib/libc.musl-aarch64.so.1 ] \
        || ldd /bin/ls 2>&1 | grep -q musl; then
        platform="linux-${arch}-musl"
    else
        platform="linux-${arch}"
    fi

    [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[A-Za-z0-9._]+)?$ ]] || {
        echo "✗ Failed to fetch version for Claude Code"
        return 1
    }
    manifest=$(curl -fLsS --max-time 30 "$base/$version/manifest.json")
    zst_manifest=$(curl -fLsS --max-time 30 "$base/$version/manifest.zst.json")
    binary_sum=$(json_platform_value "$manifest" "$platform" checksum || true)
    binary_size=$(json_platform_value "$manifest" "$platform" size || true)
    archive_sum=$(json_platform_value "$zst_manifest" "$platform" checksum || true)
    [[ "$binary_sum" =~ ^[0-9a-f]{64}$ && "$archive_sum" =~ ^[0-9a-f]{64}$ \
        && "$binary_size" =~ ^[1-9][0-9]*$ ]] || {
        echo "✗ Failed to fetch archive/checksum info for Claude Code ($platform)"
        return 1
    }

    url="$base/$version/$platform/claude.zst"
    download_zstd_binary_to_dir "Claude Code" "claude" "claude" \
        "$url" "$version" "$archive_sum" "$binary_sum" "$binary_size"
}

install_grok() {
    # Official Grok Build CLI (https://x.ai/cli). Source is open on GitHub
    # (xai-org/grok-build) but prebuilt binaries are published only via the
    # x.ai/cli CDN / GCS bucket — no GitHub release assets.
    local version arch platform url meta md5_b64 md5_hex
    local base_primary="https://x.ai/cli"
    local base_fallback="https://storage.googleapis.com/grok-build-public-artifacts/cli"

    version=$(curl -fLsS --max-time 30 "${base_primary}/stable" 2>/dev/null \
        | tr -d '\r' | head -n1 | tr -d '[:space:]') || version=
    if [[ ! "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[A-Za-z0-9._]+)?$ ]]; then
        version=$(curl -fLsS --max-time 30 "${base_fallback}/stable" 2>/dev/null \
            | tr -d '\r' | head -n1 | tr -d '[:space:]') || version=
    fi
    [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[A-Za-z0-9._]+)?$ ]] || {
        echo "✗ Failed to fetch version for Grok"
        return 1
    }

    case "$(uname -m)" in
        x86_64|amd64) arch=x86_64 ;;
        aarch64|arm64) arch=aarch64 ;;
        *)
            echo "✗ Grok does not publish a Linux binary for architecture $(uname -m)"
            return 1
            ;;
    esac

    platform="linux-${arch}"
    url="${base_primary}/grok-${version}-${platform}"

    # Publisher ships no separate SHA-256 file; GCS object metadata includes
    # the object MD5 (same integrity model as the official install.sh which
    # only smoke-runs --version after download).
    meta=$(curl -fLsS --max-time 30 \
        "https://storage.googleapis.com/storage/v1/b/grok-build-public-artifacts/o/cli%2Fgrok-${version}-${platform}" \
        2>/dev/null) || true
    md5_b64=$(grep -oP '"md5Hash": "\K[^"]+' <<<"$meta" | head -1)
    if [ -n "$md5_b64" ]; then
        md5_hex=$(printf '%s' "$md5_b64" | base64 -d 2>/dev/null | od -An -tx1 | tr -d ' \n')
    fi
    [[ "$md5_hex" =~ ^[0-9a-f]{32}$ ]] || {
        echo "✗ Failed to fetch checksum for Grok"
        return 1
    }

    download_single_binary "Grok" "grok" "$url" "$version" "md5:${md5_hex}" \
        "${base_fallback}/grok-${version}-${platform}"
}

install_obsidian() {
    # Obsidian publishes no checksums in its release assets — unverified.
    local version=$(github_api https://api.github.com/repos/obsidianmd/obsidian-releases/releases/latest | grep -oP '"tag_name": "\K[^"]+' | sed 's/^v//')
    local url="https://github.com/obsidianmd/obsidian-releases/releases/download/v${version}/obsidian-${version}.tar.gz"
    download_and_extract "Obsidian" "obsidian" "$url" "$version" 1 "" "obsidian"
    create_desktop_file "obsidian" "Obsidian" "$BASE_DIR/obsidian/obsidian --no-sandbox" "$BASE_DIR/obsidian/resources/icon.png" "Obsidian Notes"
}

install_corretto() {
    local jdk_version=$1
    local latest=$(github_api "https://api.github.com/repos/corretto/corretto-${jdk_version}/releases/latest" | grep -oP '"tag_name": "\K[^"]+')
    local version=${latest#*-}
    local url="https://corretto.aws/downloads/latest/amazon-corretto-${jdk_version}-x64-linux-jdk.tar.gz"
    local sum=$(fetch_checksum "https://corretto.aws/downloads/latest_sha256/amazon-corretto-${jdk_version}-x64-linux-jdk.tar.gz")
    [ -n "$sum" ] || { echo "✗ Failed to fetch checksum for Corretto JDK ${jdk_version}"; return 1; }

    download_and_extract "Amazon Corretto JDK ${jdk_version}" "jdk/${jdk_version}" \
        "$url" "$version" 1 "$sum" "bin/java"
}

install_corretto_all() {
    local ver
    for ver in 8 11 17 21 23; do
        install_corretto "$ver"
    done
}

install_gradle() {
    local version=$(github_api https://api.github.com/repos/gradle/gradle/releases/latest | grep -oP '"tag_name": "\K[^"]+' | sed 's/^v//')

    if [ -z "$version" ]; then
        echo "✗ Failed to fetch version for Gradle"
        return 1
    fi

    local url="https://services.gradle.org/distributions/gradle-${version}-bin.zip"
    local version_file="$BASE_DIR/gradle/.version"
    local current_version=""

    [ -f "$version_file" ] && current_version=$(<"$version_file")

    if [ "$current_version" = "$version" ] && [ -x "$BASE_DIR/gradle/bin/gradle" ]; then
        echo "✓ Gradle already at version $version"
        return 0
    fi
    [ "$current_version" != "$version" ] || echo "→ Rebuilding incomplete Gradle $version installation"

    local sum=$(fetch_checksum "${url}.sha256")
    [ -n "$sum" ] || { echo "✗ Failed to fetch checksum for Gradle"; return 1; }

    echo "→ Downloading Gradle $version..."
    local temp_dir="$BASE_DIR/gradle_temp"
    rm -rf "$temp_dir"
    mkdir -p "$temp_dir"

    download_file "$url" "$temp_dir/gradle.zip"
    verify_file "$temp_dir/gradle.zip" "$sum" || { rm -rf "$temp_dir"; return 1; }
    unzip -q "$temp_dir/gradle.zip" -d "$temp_dir"

    rm -rf "$BASE_DIR/gradle"
    mv "$temp_dir/gradle-${version}" "$BASE_DIR/gradle"
    rm -rf "$temp_dir"
    echo "$version" > "$version_file"
    echo "✓ Gradle $version installed"
}

install_maven() {
    local version=$(curl -s https://dlcdn.apache.org/maven/maven-3/ | grep -oP 'href="\K[0-9]+\.[0-9]+\.[0-9]+(?=/)' | sort -V | tail -1)

    if [ -z "$version" ]; then
        echo "✗ Failed to fetch version for Maven"
        return 1
    fi

    local url="https://dlcdn.apache.org/maven/maven-3/${version}/binaries/apache-maven-${version}-bin.tar.gz"
    local version_file="$BASE_DIR/maven/.version"
    local current_version=""

    [ -f "$version_file" ] && current_version=$(<"$version_file")

    if [ "$current_version" = "$version" ] && [ -x "$BASE_DIR/maven/bin/mvn" ]; then
        echo "✓ Maven already at version $version"
        return 0
    fi
    [ "$current_version" != "$version" ] || echo "→ Rebuilding incomplete Maven $version installation"

    # Cross-host verification: artifact from the CDN, canonical sha512 from
    # Apache's origin server — tampering would have to hit both.
    local sum=$(fetch_checksum "https://downloads.apache.org/maven/maven-3/${version}/binaries/apache-maven-${version}-bin.tar.gz.sha512" "" 128)
    [ -n "$sum" ] || { echo "✗ Failed to fetch checksum for Maven"; return 1; }

    echo "→ Downloading Maven $version..."
    local temp_dir="$BASE_DIR/maven_temp"
    rm -rf "$temp_dir"
    mkdir -p "$temp_dir"

    # Download to file first, verify, then extract
    download_file "$url" "$temp_dir/maven.tar.gz"
    verify_file "$temp_dir/maven.tar.gz" "sha512:$sum" || { rm -rf "$temp_dir"; return 1; }
    tar xzf "$temp_dir/maven.tar.gz" -C "$temp_dir" --strip-components=1
    rm "$temp_dir/maven.tar.gz"

    rm -rf "$BASE_DIR/maven"
    mv "$temp_dir" "$BASE_DIR/maven"
    echo "$version" > "$version_file"
    echo "✓ Maven $version installed"
}

install_pgadmin() {
    # pgAdmin uses tags like "REL-9_10" instead of releases
    local tag=$(github_api https://api.github.com/repos/pgadmin-org/pgadmin4/tags | grep -oP '"name": "REL-\K[0-9]+_[0-9]+' | head -1)

    if [ -z "$tag" ]; then
        echo "✗ Failed to fetch version for pgAdmin"
        return 1
    fi

    # Convert REL-9_10 to 9.10
    local version=$(echo "$tag" | tr '_' '.')
    local url="https://ftp.postgresql.org/pub/pgadmin/pgadmin4/v${version}/pip/pgadmin4-${version}-py3-none-any.whl"
    local version_file="$BASE_DIR/pgadmin/.version"
    local current_version=""

    [ -f "$version_file" ] && current_version=$(cat "$version_file")

    if [ "$current_version" = "$version" ]; then
        echo "✓ pgAdmin already at version $version"
        return 0
    fi

    echo "→ Downloading pgAdmin $version..."
    local temp_dir="$BASE_DIR/pgadmin_temp"
    rm -rf "$temp_dir"
    mkdir -p "$temp_dir"

    download_file "$url" "$temp_dir/pgadmin4.whl"
    unzip -q "$temp_dir/pgadmin4.whl" -d "$temp_dir"

    rm -rf "$BASE_DIR/pgadmin"
    mv "$temp_dir" "$BASE_DIR/pgadmin"
    echo "$version" > "$version_file"

    cat > "$BASE_DIR/pgadmin/pgadmin4" <<'EOF'
#!/bin/bash
cd "$(dirname "$0")"
python3 -m pgadmin4
EOF
    chmod +x "$BASE_DIR/pgadmin/pgadmin4"

    echo "✓ pgAdmin $version installed"
    create_desktop_file "pgadmin4" "pgAdmin 4" "$BASE_DIR/pgadmin/pgadmin4" "$BASE_DIR/pgadmin/pgadmin4/static/img/logo-256.png" "PostgreSQL Tools"
}

# expected is the publisher checksum. fallback_url is used for Grok's mirror.
download_single_binary() (
    set -e
    set -o pipefail
    local name=$1 binary=$2 url=$3 version=$4 expected=${5:-}
    local fallback_url=${6:-} used_fallback=0
    local version_file="$BASE_DIR/.versions/$binary"
    local digest_file="$BASE_DIR/.versions/$binary.sha256"
    local current_version="" lock_fd temp_file

    [ -n "$version" ] || { echo "✗ Failed to fetch version for $name"; return 1; }
    acquire_tool_lock "bin-$binary" lock_fd
    : "$lock_fd"
    [ -f "$version_file" ] && current_version=$(<"$version_file")
    if [ "$current_version" = "$version" ]         && installed_binary_matches "$BASE_DIR/bin/$binary" "$digest_file"; then
        echo "✓ $name already at version $version"
        return 0
    fi
    [ "$current_version" != "$version" ]         || echo "→ Repairing incomplete $name $version installation"

    echo "→ Downloading $name $version..."
    make_shared_directory "$BASE_DIR/bin"
    make_shared_directory "$BASE_DIR/.versions"
    temp_file=$(mktemp "$BASE_DIR/bin/.${binary}.staging.XXXXXX")
    trap 'rm -f "$temp_file" "$temp_file.aria2"' EXIT
    if ! download_file "$url" "$temp_file"; then
        [ -n "$fallback_url" ] || return 1
        echo "→ Primary download failed; trying publisher fallback"
        rm -f "$temp_file" "$temp_file.aria2"
        download_file "$fallback_url" "$temp_file"
        used_fallback=1
    fi
    if [ -n "$expected" ] && ! verify_file "$temp_file" "$expected"; then
        [ -n "$fallback_url" ] && [ "$used_fallback" -eq 0 ] || return 1
        echo "→ Primary checksum failed; trying publisher fallback"
        rm -f "$temp_file" "$temp_file.aria2"
        download_file "$fallback_url" "$temp_file"
        verify_file "$temp_file" "$expected"
    elif [ -z "$expected" ]; then
        echo "  ⚠ $name: publisher provides no checksum — installing unverified"
    fi
    [ -s "$temp_file" ] || { echo "✗ Downloaded $name executable is empty"; return 1; }
    chmod 0755 "$temp_file"
    mv -fT "$temp_file" "$BASE_DIR/bin/$binary"
    temp_file=
    printf '%s\n' "$version" > "$version_file"
    sha256sum "$BASE_DIR/bin/$binary" | awk '{print $1}' > "$digest_file"
    chmod 0644 "$version_file" "$digest_file"
    trap - EXIT
    echo "✓ $name $version installed"
)


install_kubectl() {
    local version=$(curl -sL https://dl.k8s.io/release/stable.txt)
    local url="https://dl.k8s.io/release/${version}/bin/linux/amd64/kubectl"
    local sum=$(fetch_checksum "${url}.sha256")
    [ -n "$sum" ] || { echo "✗ Failed to fetch checksum for kubectl"; return 1; }
    download_single_binary "kubectl" "kubectl" "$url" "$version" "$sum"
}

install_kind() {
    local version=$(github_api https://api.github.com/repos/kubernetes-sigs/kind/releases/latest | grep -oP '"tag_name": "\K[^"]+')
    local url="https://github.com/kubernetes-sigs/kind/releases/download/${version}/kind-linux-amd64"
    local sum=$(fetch_checksum "${url}.sha256sum" "kind-linux-amd64")
    [ -n "$sum" ] || { echo "✗ Failed to fetch checksum for kind"; return 1; }
    download_single_binary "kind" "kind" "$url" "$version" "$sum"
}

install_k9s() {
    local version=$(github_api https://api.github.com/repos/derailed/k9s/releases/latest | grep -oP '"tag_name": "\K[^"]+')
    local url="https://github.com/derailed/k9s/releases/download/${version}/k9s_Linux_amd64.tar.gz"
    local sum=$(fetch_checksum "https://github.com/derailed/k9s/releases/download/${version}/checksums.sha256" "k9s_Linux_amd64.tar.gz")
    [ -n "$sum" ] || { echo "✗ Failed to fetch checksum for k9s"; return 1; }
    download_and_extract "k9s" "k9s" "$url" "$version" 0 "$sum" "k9s"
}

install_helm() {
    local version=$(github_api https://api.github.com/repos/helm/helm/releases/latest | grep -oP '"tag_name": "\K[^"]+')
    local url="https://get.helm.sh/helm-${version}-linux-amd64.tar.gz"
    local sum=$(fetch_checksum "${url}.sha256")
    [ -n "$sum" ] || { echo "✗ Failed to fetch checksum for Helm"; return 1; }
    download_and_extract "Helm" "helm" "$url" "$version" 1 "$sum" "helm"
}

install_stern() {
    local version=$(github_api https://api.github.com/repos/stern/stern/releases/latest | grep -oP '"tag_name": "\K[^"]+')
    local file="stern_${version#v}_linux_amd64.tar.gz"
    local url="https://github.com/stern/stern/releases/download/${version}/${file}"
    local sum=$(fetch_checksum "https://github.com/stern/stern/releases/download/${version}/checksums.txt" "$file")
    [ -n "$sum" ] || { echo "✗ Failed to fetch checksum for Stern"; return 1; }
    download_and_extract "Stern" "stern" "$url" "$version" 0 "$sum" "stern"
}

install_skaffold() {
    local version=$(github_api https://api.github.com/repos/GoogleContainerTools/skaffold/releases/latest | grep -oP '"tag_name": "\K[^"]+')
    local url="https://github.com/GoogleContainerTools/skaffold/releases/download/${version}/skaffold-linux-amd64"
    local sum=$(fetch_checksum "${url}.sha256" "skaffold-linux-amd64")
    [ -n "$sum" ] || { echo "✗ Failed to fetch checksum for Skaffold"; return 1; }
    download_single_binary "Skaffold" "skaffold" "$url" "$version" "$sum"
}

install_jq() {
    local version=$(github_api https://api.github.com/repos/jqlang/jq/releases/latest | grep -oP '"tag_name": "\K[^"]+')
    local url="https://github.com/jqlang/jq/releases/download/${version}/jq-linux-amd64"
    local sum=$(fetch_checksum "https://github.com/jqlang/jq/releases/download/${version}/sha256sum.txt" "jq-linux-amd64")
    [ -n "$sum" ] || { echo "✗ Failed to fetch checksum for jq"; return 1; }
    download_single_binary "jq" "jq" "$url" "$version" "$sum"
}

install_yq() {
    local version=$(github_api https://api.github.com/repos/mikefarah/yq/releases/latest | grep -oP '"tag_name": "\K[^"]+')
    local base="https://github.com/mikefarah/yq/releases/download/${version}"
    local url="${base}/yq_linux_amd64"
    # yq's "checksums" file has one row per file and one column per hash
    # algorithm; the column order is published in checksums_hashes_order.
    local idx=$(curl -fLsS "${base}/checksums_hashes_order" 2>/dev/null | grep -nx 'SHA-256' | cut -d: -f1)
    local sum=""
    [ -n "$idx" ] && sum=$(curl -fLsS "${base}/checksums" 2>/dev/null \
        | awk -v c=$((idx + 1)) '$1 == "yq_linux_amd64" { print tolower($c); exit }' \
        | grep -E '^[0-9a-f]{64}$' || true)
    [ -n "$sum" ] || { echo "✗ Failed to fetch checksum for yq"; return 1; }
    download_single_binary "yq" "yq" "$url" "$version" "$sum"
}

install_ffmpeg() {
    # BtbN dropped nonfree builds; gpl is the closest remaining variant.
    local version=$(github_api https://api.github.com/repos/BtbN/FFmpeg-Builds/releases/latest | grep -oP '"tag_name": "\K[^"]+')
    local file="ffmpeg-master-latest-linux64-gpl.tar.xz"
    local url="https://github.com/BtbN/FFmpeg-Builds/releases/download/${version}/${file}"
    local version_file="$BASE_DIR/ffmpeg/.version"
    local current_version=""

    if [ -z "$version" ]; then
        echo "✗ Failed to fetch version for FFmpeg"
        return 1
    fi

    [ -f "$version_file" ] && current_version=$(cat "$version_file")

    if [ "$current_version" = "$version" ] && [ -x "$BASE_DIR/ffmpeg/bin/ffmpeg" ]; then
        echo "✓ FFmpeg already at version $version"
        return 0
    fi
    [ "$current_version" != "$version" ] || echo "→ Rebuilding incomplete FFmpeg $version installation"

    local sum=$(fetch_checksum "https://github.com/BtbN/FFmpeg-Builds/releases/download/${version}/checksums.sha256" "$file")
    [ -n "$sum" ] || { echo "✗ Failed to fetch checksum for FFmpeg"; return 1; }

    echo "→ Downloading FFmpeg $version..."
    local temp_dir="$BASE_DIR/ffmpeg_temp"
    rm -rf "$temp_dir"
    mkdir -p "$temp_dir"

    download_file "$url" "$temp_dir/ffmpeg.tar.xz"
    verify_file "$temp_dir/ffmpeg.tar.xz" "$sum" || { rm -rf "$temp_dir"; return 1; }
    tar xJf "$temp_dir/ffmpeg.tar.xz" -C "$temp_dir" --strip-components=1
    rm "$temp_dir/ffmpeg.tar.xz"

    rm -rf "$BASE_DIR/ffmpeg"
    mv "$temp_dir" "$BASE_DIR/ffmpeg"
    echo "$version" > "$version_file"
    echo "✓ FFmpeg $version installed"
}

# Default install set; pass tool names as arguments to install a subset.
ALL_TOOLS=(idea nushell starship herdr codex grok pi claude obsidian gradle maven
           kubectl kind k9s helm stern skaffold jq yq ffmpeg corretto_all)

if [ $# -gt 0 ]; then
    TOOLS=("$@")
else
    TOOLS=("${ALL_TOOLS[@]}")
fi

for tool in "${TOOLS[@]}"; do
    if ! declare -F "install_${tool}" >/dev/null; then
        echo "✗ Unknown tool: $tool (available: ${ALL_TOOLS[*]})"
        exit 1
    fi
done

echo "Starting software installation in $BASE_DIR..."
for tool in "${TOOLS[@]}"; do
    "install_${tool}"
done

mkdir -p "$BASE_DIR/bin"
chmod 0755 "$BASE_DIR/bin"
[ -f "$BASE_DIR/gradle/bin/gradle" ] && ln -sf "$BASE_DIR/gradle/bin/gradle" "$BASE_DIR/bin/gradle"
[ -f "$BASE_DIR/maven/bin/mvn" ] && ln -sf "$BASE_DIR/maven/bin/mvn" "$BASE_DIR/bin/mvn"
[ -f "$BASE_DIR/nushell/nu" ] && ln -sf "$BASE_DIR/nushell/nu" "$BASE_DIR/bin/nu"
[ -f "$BASE_DIR/starship/starship" ] && ln -sf "$BASE_DIR/starship/starship" "$BASE_DIR/bin/starship"
[ -f "$BASE_DIR/k9s/k9s" ] && ln -sf "$BASE_DIR/k9s/k9s" "$BASE_DIR/bin/k9s"
[ -f "$BASE_DIR/helm/helm" ] && ln -sf "$BASE_DIR/helm/helm" "$BASE_DIR/bin/helm"
[ -f "$BASE_DIR/stern/stern" ] && ln -sf "$BASE_DIR/stern/stern" "$BASE_DIR/bin/stern"
[ -f "$BASE_DIR/idea/bin/idea.sh" ] && ln -sf "$BASE_DIR/idea/bin/idea.sh" "$BASE_DIR/bin/idea"
[ -f "$BASE_DIR/obsidian/obsidian" ] && ln -sf "$BASE_DIR/obsidian/obsidian" "$BASE_DIR/bin/obsidian"
[ -f "$BASE_DIR/ffmpeg/bin/ffmpeg" ] && ln -sf "$BASE_DIR/ffmpeg/bin/ffmpeg" "$BASE_DIR/bin/ffmpeg"
[ -f "$BASE_DIR/ffmpeg/bin/ffplay" ] && ln -sf "$BASE_DIR/ffmpeg/bin/ffplay" "$BASE_DIR/bin/ffplay"
[ -f "$BASE_DIR/ffmpeg/bin/ffprobe" ] && ln -sf "$BASE_DIR/ffmpeg/bin/ffprobe" "$BASE_DIR/bin/ffprobe"
[ -f "$BASE_DIR/codex/codex-x86_64-unknown-linux-musl" ] && ln -sf "$BASE_DIR/codex/codex-x86_64-unknown-linux-musl" "$BASE_DIR/bin/codex"
[ -f "$BASE_DIR/codex/codex-aarch64-unknown-linux-musl" ] && ln -sf "$BASE_DIR/codex/codex-aarch64-unknown-linux-musl" "$BASE_DIR/bin/codex"
[ -f "$BASE_DIR/pi/pi" ] && ln -sf "$BASE_DIR/pi/pi" "$BASE_DIR/bin/pi"
[ -f "$BASE_DIR/claude/claude" ] && ln -sf "$BASE_DIR/claude/claude" "$BASE_DIR/bin/claude"

cat > "$BASE_DIR/env.sh" <<EOF
# Generated by jan-update-opt
export PATH="\$PATH:$BASE_DIR/bin"
EOF
chmod 0644 "$BASE_DIR/env.sh"

echo ""
echo "All software installed successfully!"
echo "Base directory: $BASE_DIR"
[ "$EUID" -ne 0 ] && echo "Desktop files: $DESKTOP_DIR"
echo ""
echo "To use installed tools, add this to your shell config:"
echo "  source $BASE_DIR/env.sh"
