install_yq() {
    local version=$(github_api https://api.github.com/repos/mikefarah/yq/releases/latest | grep -oP '"tag_name": "\K[^"]+')
    local base="https://github.com/mikefarah/yq/releases/download/${version}"
    local url="${base}/yq_linux_amd64"
    # yq's "checksums" file has one row per file and one column per hash
    # algorithm; the column order is published in checksums_hashes_order.
    local idx=$(curl -fLsS "${base}/checksums_hashes_order" 2>/dev/null | grep -nx 'SHA-256' | cut -d: -f1)
    local sum=""
    [ -n "$idx" ] && sum=$(curl -fLsS "${base}/checksums" 2>/dev/null \
        | awk -v c=$((idx + 1)) '$1 == "yq_linux_amd64" { print tolower($c); exit }' \
        | grep -E '^[0-9a-f]{64}$' || true)
    [ -n "$sum" ] || { echo "✗ Failed to fetch checksum for yq"; return 1; }
    download_single_binary "yq" "yq" "$url" "$version" "$sum"
}

install_ollama() {
    local version=$(github_api https://api.github.com/repos/ollama/ollama/releases/latest | grep -oP '"tag_name": "\K[^"]+')
    local url="https://github.com/ollama/ollama/releases/download/${version}/ollama-linux-amd64.tar.zst"
    local version_file="$BASE_DIR/ollama/.version"
    local current_version=""

    if [ -z "$version" ]; then
        echo "✗ Failed to fetch version for Ollama"
        return 1
    fi

    [ -f "$version_file" ] && current_version=$(cat "$version_file")

    if [ "$current_version" = "$version" ]; then
        echo "✓ Ollama already at version $version"
        return 0
    fi

    local sum=$(fetch_checksum "https://github.com/ollama/ollama/releases/download/${version}/sha256sum.txt" "ollama-linux-amd64.tar.zst")
    [ -n "$sum" ] || { echo "✗ Failed to fetch checksum for Ollama"; return 1; }

    echo "→ Downloading Ollama $version..."
    local temp_dir="$BASE_DIR/ollama_temp"
    rm -rf "$temp_dir"
    mkdir -p "$temp_dir"

    curl -fLsS "$url" -o "$temp_dir/ollama.tar.zst"
    verify_file "$temp_dir/ollama.tar.zst" "$sum" || { rm -rf "$temp_dir"; return 1; }
    tar --zstd -xf "$temp_dir/ollama.tar.zst" -C "$temp_dir"
    rm "$temp_dir/ollama.tar.zst"

    rm -rf "$BASE_DIR/ollama"
    mv "$temp_dir" "$BASE_DIR/ollama"
    echo "$version" > "$version_file"
    echo "✓ Ollama $version installed"
}

install_ffmpeg() {
    # BtbN dropped nonfree builds; gpl is the closest remaining variant.
    local version=$(github_api https://api.github.com/repos/BtbN/FFmpeg-Builds/releases/latest | grep -oP '"tag_name": "\K[^"]+')
    local file="ffmpeg-master-latest-linux64-gpl.tar.xz"
    local url="https://github.com/BtbN/FFmpeg-Builds/releases/download/${version}/${file}"
    local version_file="$BASE_DIR/ffmpeg/.version"
    local current_version=""

    if [ -z "$version" ]; then
        echo "✗ Failed to fetch version for FFmpeg"
        return 1
    fi

    [ -f "$version_file" ] && current_version=$(cat "$version_file")

    if [ "$current_version" = "$version" ]; then
        echo "✓ FFmpeg already at version $version"
        return 0
    fi

    local sum=$(fetch_checksum "https://github.com/BtbN/FFmpeg-Builds/releases/download/${version}/checksums.sha256" "$file")
    [ -n "$sum" ] || { echo "✗ Failed to fetch checksum for FFmpeg"; return 1; }

    echo "→ Downloading FFmpeg $version..."
    local temp_dir="$BASE_DIR/ffmpeg_temp"
    rm -rf "$temp_dir"
    mkdir -p "$temp_dir"

    curl -fLsS "$url" -o "$temp_dir/ffmpeg.tar.xz"
    verify_file "$temp_dir/ffmpeg.tar.xz" "$sum" || { rm -rf "$temp_dir"; return 1; }
    tar xJf "$temp_dir/ffmpeg.tar.xz" -C "$temp_dir" --strip-components=1
    rm "$temp_dir/ffmpeg.tar.xz"

    rm -rf "$BASE_DIR/ffmpeg"
    mv "$temp_dir" "$BASE_DIR/ffmpeg"
    echo "$version" > "$version_file"
    echo "✓ FFmpeg $version installed"
}

# Default install set; pass tool names as arguments to install a subset,
# e.g.:  jan-update-opt jq yq kubectl
ALL_TOOLS=(idea nushell starship herdr grok obsidian gradle maven kubectl kind k9s helm
           stern skaffold jq yq ollama ffmpeg corretto_all)
#          pgadmin disabled

if [ $# -gt 0 ]; then
    TOOLS=("$@")
else
    TOOLS=("${ALL_TOOLS[@]}")
fi

for tool in "${TOOLS[@]}"; do
    if ! declare -F "install_${tool}" >/dev/null; then
        echo "✗ Unknown tool: $tool (available: ${ALL_TOOLS[*]})"
        exit 1
    fi
done

echo "Starting software installation in $BASE_DIR..."

for tool in "${TOOLS[@]}"; do
    "install_${tool}"
done

# Create symlinks in bin directory for all tools
mkdir -p "$BASE_DIR/bin"
[ -f "$BASE_DIR/gradle/bin/gradle" ] && ln -sf "$BASE_DIR/gradle/bin/gradle" "$BASE_DIR/bin/gradle"
[ -f "$BASE_DIR/maven/bin/mvn" ] && ln -sf "$BASE_DIR/maven/bin/mvn" "$BASE_DIR/bin/mvn"
[ -f "$BASE_DIR/nushell/nu" ] && ln -sf "$BASE_DIR/nushell/nu" "$BASE_DIR/bin/nu"
[ -f "$BASE_DIR/starship/starship" ] && ln -sf "$BASE_DIR/starship/starship" "$BASE_DIR/bin/starship"
[ -f "$BASE_DIR/k9s/k9s" ] && ln -sf "$BASE_DIR/k9s/k9s" "$BASE_DIR/bin/k9s"
[ -f "$BASE_DIR/helm/helm" ] && ln -sf "$BASE_DIR/helm/helm" "$BASE_DIR/bin/helm"
[ -f "$BASE_DIR/stern/stern" ] && ln -sf "$BASE_DIR/stern/stern" "$BASE_DIR/bin/stern"
[ -f "$BASE_DIR/idea/bin/idea.sh" ] && ln -sf "$BASE_DIR/idea/bin/idea.sh" "$BASE_DIR/bin/idea"
[ -f "$BASE_DIR/obsidian/obsidian" ] && ln -sf "$BASE_DIR/obsidian/obsidian" "$BASE_DIR/bin/obsidian"
[ -f "$BASE_DIR/ollama/bin/ollama" ] && ln -sf "$BASE_DIR/ollama/bin/ollama" "$BASE_DIR/bin/ollama"
[ -f "$BASE_DIR/ffmpeg/bin/ffmpeg" ] && ln -sf "$BASE_DIR/ffmpeg/bin/ffmpeg" "$BASE_DIR/bin/ffmpeg"
[ -f "$BASE_DIR/ffmpeg/bin/ffplay" ] && ln -sf "$BASE_DIR/ffmpeg/bin/ffplay" "$BASE_DIR/bin/ffplay"
[ -f "$BASE_DIR/ffmpeg/bin/ffprobe" ] && ln -sf "$BASE_DIR/ffmpeg/bin/ffprobe" "$BASE_DIR/bin/ffprobe"

cat > "$BASE_DIR/env.sh" <<EOF
# Generated by install-software.sh
# Source this file from your shell config (.bashrc, .zshrc, etc.)
# Example: echo 'source $BASE_DIR/env.sh' >> ~/.bashrc

export PATH="\$PATH:$BASE_DIR/bin"
EOF

echo ""
echo "All software installed successfully!"
echo "Base directory: $BASE_DIR"
[ "$EUID" -ne 0 ] && echo "Desktop files: $DESKTOP_DIR"
echo ""
echo "To use installed tools, add this to your shell config:"
echo "  source $BASE_DIR/env.sh"
