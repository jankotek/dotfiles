#!/bin/bash
# Replace passwords for every named account with a fresh 15-character secret.
# Successful output is tab-separated USER/PASSWORD data, one account per line.

set -Eeuo pipefail

readonly PASSWORD_LENGTH=15

usage() {
    echo "Usage: $0 USER [USER ...]" >&2
}

if (( EUID != 0 )); then
    echo "ERROR: jan-randomize-user-passwords must run as root" >&2
    exit 1
fi

if (( $# == 0 )); then
    usage
    exit 2
fi

for required_command in pwgen chpasswd flock; do
    if ! command -v "$required_command" >/dev/null; then
        echo "ERROR: required command is missing: $required_command" >&2
        exit 1
    fi
done

declare -a users=()
declare -A seen=()
for user in "$@"; do
    # chpasswd uses colon-separated records. Permit any existing NSS account
    # name that can be represented safely in that format, including locally
    # permitted uppercase or dotted names.
    if [[ -z $user || $user == *:* || $user == *$'\n'* ]]; then
        echo "ERROR: invalid user name: $user" >&2
        exit 2
    fi
    if ! getent passwd "$user" >/dev/null; then
        echo "ERROR: account does not exist: $user" >&2
        exit 1
    fi
    if [[ -n ${seen[$user]:-} ]]; then
        echo "ERROR: account listed more than once: $user" >&2
        exit 2
    fi
    seen[$user]=1
    users+=("$user")
done

# Reject an overlapping batch instead of waiting and immediately superseding
# credentials printed by the first invocation.
exec 9>/run/lock/jan-randomize-user-passwords.lock
if ! flock -n 9; then
    echo "ERROR: another password-randomization batch is already running" >&2
    exit 1
fi

generate_password() {
    local password

    # pwgen -s selects independent random characters. Retry until all three
    # allowed character classes occur, while rejecting every other character.
    for _ in {1..100}; do
        password=$(LC_ALL=C pwgen -s -c -n "$PASSWORD_LENGTH" 1)
        if [[ $password =~ ^[A-Za-z0-9]{15}$ \
            && $password =~ [a-z] \
            && $password =~ [A-Z] \
            && $password =~ [0-9] ]]; then
            printf '%s' "$password"
            return 0
        fi
    done

    echo "ERROR: pwgen did not produce a valid password after 100 attempts" >&2
    return 1
}

declare -a passwords=()
declare -A generated=()
for user in "${users[@]}"; do
    while :; do
        password=$(generate_password)
        if [[ -z ${generated[$password]:-} ]]; then
            generated[$password]=1
            passwords+=("$password")
            break
        fi
    done
done

# Tumbleweed's PAM-backed chpasswd cannot roll back earlier records when a
# later record fails. Update one account at a time and print its credential
# immediately after success. On partial failure, stdout remains an exact list
# of the accounts that were changed rather than losing their new passwords.
printf 'USER\tPASSWORD\n'
for index in "${!users[@]}"; do
    if ! printf '%s:%s\n' "${users[$index]}" "${passwords[$index]}" | chpasswd; then
        echo "ERROR: password update failed for ${users[$index]}" >&2
        exit 1
    fi
    printf '%s\t%s\n' "${users[$index]}" "${passwords[$index]}"
done
