#!/bin/bash
set -euo pipefail

# Install the information and actions menu on TTY12.

install_service() {
    local service_file="${SYSTEMD_DIR:-/etc/systemd/system}/tty12-menu.service"
    cat > "$service_file" <<'EOF'
[Unit]
Description=Menu and info on TTY12

[Service]
ExecStart=/usr/local/sbin/tty12-menu
TTYPath=/dev/tty12
User=root
StandardInput=tty-force
StandardOutput=tty
StandardError=tty
Type=idle
Restart=always
RestartSec=0
KillMode=control-group
IgnoreSIGPIPE=no
TimeoutStopSec=90
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    systemctl enable tty12-menu.service
    systemctl start tty12-menu.service

    echo "Service installed and started successfully."
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
    if [ "$EUID" -ne 0 ]; then
        echo "Please run as root" >&2
        exit 1
    fi
    install_service
fi
