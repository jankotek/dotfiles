#!/bin/bash
set -euo pipefail

if [ "$EUID" -ne 0 ]; then
    echo "must run as root" >&2
    exit 1
fi

# sshd keeps the first value it reads, so sort before 00-dotfiles.conf,
# cloud-init and other drop-ins, then check the effective setting.
rm -f /etc/ssh/sshd_config.d/pw-disable.conf
cat > /etc/ssh/sshd_config.d/00-00-jan-pw-disable.conf <<'EOF'
# Password login disabled
PasswordAuthentication no
ChallengeResponseAuthentication no
PermitEmptyPasswords no
PubkeyAuthentication yes
EOF

sshd -t
sshd -T | grep -qix 'passwordauthentication no' \
    || { echo "ERROR: another sshd setting still allows passwords" >&2; exit 1; }
systemctl reload sshd 2>/dev/null || systemctl reload ssh 2>/dev/null || true
