#!/bin/bash
set -euo pipefail

if [ "$EUID" -ne 0 ]; then
    echo "must run as root" >&2
    exit 1
fi

configure_chromium_sandbox_sysctl() {
    # Ubuntu 24.04+ can restrict unprivileged user namespaces through
    # AppArmor. These VM images remove AppArmor, so Chromium-based browsers
    # need the sysctl opened explicitly for their sandbox to initialize.
    cat > /etc/sysctl.d/30-brave.conf <<'EOF'
# Required for Chromium/Brave sandboxing on VM images without AppArmor.
kernel.unprivileged_userns_clone = 1
kernel.apparmor_restrict_unprivileged_userns = 0
EOF
    sysctl -w kernel.unprivileged_userns_clone=1 >/dev/null 2>&1 || true
    sysctl -w kernel.apparmor_restrict_unprivileged_userns=0 >/dev/null 2>&1 || true
}

. /etc/os-release

case $ID in
    opensuse-leap|opensuse-tumbleweed)
        rpm --import https://brave-browser-rpm-release.s3.brave.com/brave-core.asc
        zypper addrepo https://brave-browser-rpm-release.s3.brave.com/brave-browser.repo
        zypper --non-interactive --gpg-auto-import-keys ref
        zypper --non-interactive install brave-browser
        ;;
    fedora)
        rpm --import https://brave-browser-rpm-release.s3.brave.com/brave-core.asc
        dnf config-manager addrepo --from-repofile=https://brave-browser-rpm-release.s3.brave.com/brave-browser.repo
        dnf install -y brave-browser
        ;;
    ubuntu|debian|mint)
        apt update
        apt install -y curl gnupg
        curl -fsSL https://brave-browser-apt-release.s3.brave.com/brave-core.asc | gpg --dearmor -o /etc/apt/trusted.gpg.d/brave-browser-archive-keyring.gpg
        echo "deb [arch=amd64 signed-by=/etc/apt/trusted.gpg.d/brave-browser-archive-keyring.gpg] https://brave-browser-apt-release.s3.brave.com/ stable main" > /etc/apt/sources.list.d/brave-browser-release.list
        apt update
        apt install -y brave-browser
        ;;
    *)
        echo "Unsupported distribution: $ID" >&2
        exit 1
        ;;
esac

configure_chromium_sandbox_sysctl
ln -sfn /usr/bin/brave-browser /usr/local/bin/brave
