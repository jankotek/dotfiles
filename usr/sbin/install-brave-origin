#!/bin/bash
set -euo pipefail

#
# Installs Brave Origin (beta channel) — minimalist Brave without ads,
# rewards, AI, or VPN. Free on Linux. Stable channel does not exist yet.
#

if [ "$EUID" -ne 0 ]; then
    echo "must run as root" >&2
    exit 1
fi

configure_chromium_sandbox_sysctl() {
    # Ubuntu 24.04+ can restrict unprivileged user namespaces through
    # AppArmor. These VM images remove AppArmor, so Chromium-based browsers
    # need the sysctl opened explicitly for their sandbox to initialize.
    cat > /etc/sysctl.d/30-brave.conf <<'EOF'
# Required for Chromium/Brave sandboxing on VM images without AppArmor.
kernel.unprivileged_userns_clone = 1
kernel.apparmor_restrict_unprivileged_userns = 0
EOF
    sysctl -w kernel.unprivileged_userns_clone=1 >/dev/null 2>&1 || true
    sysctl -w kernel.apparmor_restrict_unprivileged_userns=0 >/dev/null 2>&1 || true
}

. /etc/os-release

case $ID in
    opensuse-leap|opensuse-tumbleweed)
        # Use the ASCII-armored .asc; the binary .gpg keyring on the
        # apt-beta bucket isn't valid input for `rpm --import`.
        rpm --import https://brave-browser-rpm-beta.s3.brave.com/brave-core-beta.asc
        zypper addrepo https://brave-browser-rpm-beta.s3.brave.com/brave-browser-beta.repo
        zypper --non-interactive --gpg-auto-import-keys ref
        zypper --non-interactive install brave-origin-beta
        ;;
    fedora)
        # Use the ASCII-armored .asc; the binary .gpg keyring on the
        # apt-beta bucket isn't valid input for `rpm --import`.
        rpm --import https://brave-browser-rpm-beta.s3.brave.com/brave-core-beta.asc
        dnf config-manager addrepo --from-repofile=https://brave-browser-rpm-beta.s3.brave.com/brave-browser-beta.repo
        dnf install -y brave-origin-beta
        ;;
    ubuntu|debian|mint)
        apt update
        apt install -y curl
        curl -fsSLo /usr/share/keyrings/brave-browser-beta-archive-keyring.gpg \
            https://brave-browser-apt-beta.s3.brave.com/brave-browser-beta-archive-keyring.gpg
        curl -fsSLo /etc/apt/sources.list.d/brave-browser-beta.sources \
            https://brave-browser-apt-beta.s3.brave.com/brave-browser.sources
        apt update
        apt install -y brave-origin-beta
        ;;
    *)
        echo "Unsupported distribution: $ID" >&2
        exit 1
        ;;
esac

configure_chromium_sandbox_sysctl
ln -sfn /usr/bin/brave-origin-beta /usr/local/bin/brave-origin
echo "Brave Origin (beta) installed successfully"
