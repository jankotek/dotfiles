#!/bin/bash
set -euo pipefail

#
# Installs shell with root privileges on TTY11.
# Used when sudo is removed, and root password scrambled.
#
# VM use only — anyone with console/SPICE/IPMI/KVM access gets unauthenticated
# root. Do not install on a host with untrusted physical access.
#

if [ "$EUID" -ne 0 ]; then
    echo "must run as root" >&2
    exit 1
fi

SERVICE_FILE_CONTENT="[Unit]
Description=Root terminal on TTY11

[Service]
ExecStart=-/bin/bash
TTYPath=/dev/tty11
Type=simple
User=root
StandardInput=tty-force
StandardOutput=tty
StandardError=tty
Restart=always
RestartSec=0
KillMode=control-group
IgnoreSIGPIPE=no
TimeoutStopSec=1
KillSignal=SIGKILL

[Install]
WantedBy=multi-user.target
"

# Set the service file path
SERVICE_FILE_PATH="/etc/systemd/system/tty11-root.service"

# Echo the service file content to the file
echo "$SERVICE_FILE_CONTENT" | tee "$SERVICE_FILE_PATH" > /dev/null

systemctl daemon-reload
systemctl enable tty11-root.service
systemctl restart tty11-root.service

echo "Service installed and started successfully."
