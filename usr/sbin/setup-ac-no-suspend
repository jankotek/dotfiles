#!/bin/bash
#
# Change the system defaults so the host keeps running on AC power: no idle
# suspend and no lid-close suspend. These are defaults, not locks: a user who
# sets their own value in ~/.config/powerdevilrc keeps it (ac-no-suspend
# changes one user's settings).
#
# Two layers decide whether a closed lid or an idle session suspends:
#   logind      handles the lid when no desktop holds the lid inhibitor (tty
#               logins, no session at all). HandleLidSwitchExternalPower
#               applies only while on AC; battery keeps the distro default.
#   PowerDevil  takes over lid and idle handling inside each Plasma session.
#               Its built-in defaults are compiled in; /etc/xdg/powerdevilrc
#               is the system file KConfig reads before each user's file.
#
# Manual suspend still works, and battery behavior is left unchanged. Scope is
# the ordinary idle and lid policy: PowerDevil's separate 30-second re-sleep
# after an RTC or network wake from a manual suspend is not covered.
#
set -euo pipefail

LOGIND_DIR=${LOGIND_DIR:-/etc/systemd/logind.conf.d}
XDG_DIR=${XDG_DIR:-/etc/xdg}

# Set the two AC keys in the system powerdevilrc, keeping every other group
# and key (Battery and LowBattery policy in particular). 0 = do nothing.
# Matching follows KConfig's parser: CRLF line endings, blanks around the key
# and "=", and key or group flags. Earlier variants of these keys, including
# immutable [$i] ones, are removed, and a flagged [AC][SuspendAndShutdown]
# header is rewritten plain so the group holds defaults, not locks.
merge_powerdevil_defaults() {
    local rc=$1 tmp
    tmp=$(mktemp "$rc.XXXXXX")
    {
        [[ -s $rc ]] || echo '# Managed by /opt/jan/usr/sbin/setup-ac-no-suspend'
        [[ ! -f $rc ]] || cat -- "$rc"
    } | awk '
        function emit() {
            print "AutoSuspendAction=0"
            print "LidAction=0"
            done = 1
        }
        { sub(/\r$/, "") }
        /^[ \t]*\[/ {
            in_group = ($0 ~ /^[ \t]*\[AC\]\[SuspendAndShutdown\](\[\$[^]]*\])?[ \t]*$/)
            if (in_group) {
                print "[AC][SuspendAndShutdown]"
                emit()
                next
            }
        }
        in_group && /^[ \t]*(AutoSuspendAction|LidAction)[ \t]*(\[[^]]*\])*[ \t]*=/ { next }
        { print }
        END {
            if (!done) {
                print ""
                print "[AC][SuspendAndShutdown]"
                emit()
            }
        }
    ' > "$tmp"
    chmod 0644 "$tmp"
    mv -f -- "$tmp" "$rc"
}

write_configuration() {
    install -d -m 0755 "$LOGIND_DIR" "$XDG_DIR"

    cat > "$LOGIND_DIR/80-jan-ac-no-suspend.conf" <<'EOF'
# Managed by /opt/jan/usr/sbin/setup-ac-no-suspend
[Login]
HandleLidSwitchExternalPower=ignore
EOF
    chmod 0644 "$LOGIND_DIR/80-jan-ac-no-suspend.conf"

    merge_powerdevil_defaults "$XDG_DIR/powerdevilrc"
}

main() {
    if (( EUID != 0 )); then
        echo "Please run as root" >&2
        return 1
    fi

    write_configuration

    # logind rereads its configuration on reload; never restart it, which
    # could end running sessions.
    if ! systemctl reload systemd-logind.service; then
        echo "WARNING: could not reload systemd-logind; the lid setting applies after reboot" >&2
    fi

    echo "System defaults: no idle or lid-close suspend on AC."
    echo "Users with their own powerdevilrc values keep them; running Plasma"
    echo "sessions use the new defaults after their next login."
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
    main "$@"
fi
